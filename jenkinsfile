pipeline {
  agent {
    label 'jenkins-agent-1'
  }

  environment {
    REGISTRY_URL = 'https://index.docker.io/v1/'
    REGISTRY_CREDS = 'registry-creds'

    FRONT_PATH = "${WORKSPACE}/front"
    SERVER_PATH = "${WORKSPACE}/server"
  }

  options {
    skipDefaultCheckout(true)
  }

  stages {
    stage('Preparation') {
      steps {
        checkout scm
        sh '''#!/bin/bash
            git log -n 1 | grep "commit " | sed 's/commit //g' | tee currentVersion
        '''
        stash name: 'workspace', includes: '**' // maybe use it more reasonably?
      }
    }

    stage('Front Server') {
      parallel {
        stage('Front') {
          stages {
            stage('Front Unit') {
              steps {
                unstash 'workspace'
                dir("${FRONT_PATH}") {
                  script {
                      def frontTestImage = docker.build("zubrailx/devops-front-test", "-f test-prepare.dockerfile .")
                      frontTestImage.inside("--user root") {
                        sh '''
                          cd /app
                          mv ${FRONT_PATH}/src ./
                          mv ${FRONT_PATH}/test ./
                          yarn run test
                          yarn run coverage
                        '''
                      }
                  }
                }
              }
            }
            stage('Build Front') {
              when {
                branch 'master'
              }
              steps {
                unstash 'workspace'
                script {
                  def commitHash = readFile('currentVersion').trim()

                  frontTag = "zubrailx/devops-front:${commitHash}"
                  frontImage = docker.build(frontTag, "${FRONT_PATH}")
                }
              }
            }
            stage('Push Front') {
              when {
                branch 'master'
              }
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CREDS) {
                    frontImage.push()
                    frontImage.push("latest")
                  }
                }
              }
            }
          }
        }

        stage('Server') {
          stages {
            stage('Unit Test Server') {
              steps {
                unstash 'workspace'
                dir("${SERVER_PATH}") {
                  script {
                    def serverTestImage = docker.build("zubrailx/devops-server-test", "-f test-prepare.dockerfile .")
                    serverTestImage.inside("--user root") {
                      sh '''
                        cd /app
                        mv ${SERVER_PATH}/src ./
                        mvn test
                      '''
                    }
                  }
                }
              }
            }
            stage('Build Server') {
              when {
                branch 'master'
              }
              steps {
                unstash 'workspace'
                script {
                  def commitHash = readFile('currentVersion').trim()

                  serverTag = "zubrailx/devops-server:${commitHash}"
                  serverImage = docker.build(serverTag, "${SERVER_PATH}")
                }
              }
            }
            stage('Push Server') {
              when {
                branch 'master'
              }
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CREDS) {
                    serverImage.push()
                    serverImage.push("latest")
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  post {
    always {
      cleanWs()
    }
  }
}
