pipeline {
  agent {
    label 'jenkins-agent-1'
  }

  environment {
    REGISTRY_URL = 'https://index.docker.io/v1/'
    REGISTRY_CREDS = 'registry-creds'

    FRONT_PATH = './front'
    SERVER_PATH = './server'
  }

  options {
    skipDefaultCheckout(true)
  }

  stages {
    stage('Preparation') {
      steps {
        checkout scm
        sh '''#!/bin/bash
            git log -n 1 | grep "commit " | sed 's/commit //g' | tee currentVersion
        '''
        stash name: 'workspace', includes: '**' // maybe use it more reasonably?
      }
    }

    stage('Front Server') {
      parallel {
        stage('Front') {
          stages {
            stage('Front Unit') {
              steps {
                unstash 'workspace'

                dir("${FRONT_PATH}") {
                  script {
                    def frontTestImage = docker.build("zubrailx/devops-front-yarn", "-f yarn.dockerfile .")
                    frontTestImage.inside {
                      sh 'cp /opt/build/yarn.lock .'
                      sh 'yarn install'
                      sh 'yarn run test'
                    }
                  }
                }
              }
            }
            stage('Build Front') {
              when {
                branch 'master'
              }
              steps {
                unstash 'workspace'
                script {
                  def commitHash = readFile('currentVersion').trim()

                  frontTag = "zubrailx/devops-front:${commitHash}"
                  frontImage = docker.build(frontTag, "${FRONT_PATH}")
                }
              }
            }
            stage('Push Front') {
              when {
                branch 'master'
              }
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CREDS) {
                    frontImage.push()
                    frontImage.push("latest")
                  }
                }
              }
            }
          }
        }

        stage('Server') {
          stages {
            stage('Unit Test Server') {
              steps {
                unstash 'workspace'
                dir("${SERVER_PATH}") {
                  script {
                    docker.image('maven:3.9.4-eclipse-temurin-17').inside {
                      sh 'mvn test'
                    }
                  }
                }
              }
            }
            stage('Build Server') {
              when {
                branch 'master'
              }
              steps {
                unstash 'workspace'
                script {
                  def commitHash = readFile('currentVersion').trim()

                  serverTag = "zubrailx/devops-server:${commitHash}"
                  serverImage = docker.build(serverTag, "${SERVER_PATH}")
                }
              }
            }
            stage('Push Server') {
              when {
                branch 'master'
              }
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CREDS) {
                    serverImage.push()
                    serverImage.push("latest")
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
