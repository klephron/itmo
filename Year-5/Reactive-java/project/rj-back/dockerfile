FROM openjdk:23-jdk AS builder

WORKDIR /app

ADD .mvn .mvn
ADD mvnw pom.xml .
RUN chmod +x mvnw
RUN ./mvnw dependency:resolve

ADD src src
RUN ./mvnw clean package -DskipTests


FROM eclipse-temurin:23-jre-alpine AS runner

WORKDIR /app

COPY --from=builder /app/target/*-with-dependencies.jar ./app.jar

EXPOSE 8088
ENTRYPOINT ["java", "-jar", "app.jar"]
