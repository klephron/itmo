services:
  front:
    image: zubrailx/devops-front:latest
    depends_on:
      - server
    ports:
      - "{{ nodes_front_port }}:80"

  server:
    image: zubrailx/devops-server:latest
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/{{ nodes_postgres_db }}
      SPRING_DATASOURCE_USERNAME: {{ nodes_postgres_user }}
      SPRING_DATASOURCE_PASSWORD: {{ nodes_postgres_password }}
    ports:
      - "{{ nodes_server_port }}:8080"

  postgres:
    image: postgres:17.4
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ nodes_postgres_user }}
      POSTGRES_PASSWORD: {{ nodes_postgres_password }}
      POSTGRES_DB: {{ nodes_postgres_db }}
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - postgres-data:/var/lib/postgresql/data/pgdata
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "pg_isready -U {{ nodes_postgres_user }} -d {{ nodes_postgres_db }}",
        ]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  postgres-data:
