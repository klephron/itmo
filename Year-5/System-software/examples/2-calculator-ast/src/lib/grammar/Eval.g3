tree grammar Eval;
 
options {
  language = C;
  tokenVocab = Expr;
  ASTLabelType = pANTLR3_BASE_TREE;
}
 
 
@header {
#include "util/list.h"
#include "util/util.h"
}
 
@members {
  p_list memory;
}

prog
  @init {
    memory = list_new();
    printf("list constucted\n");

  }
  @after {
    memory->free(memory);
    printf("list destructed\n");
  }
  : statement+ 
  ;

statement
  : expr {printf("\%d\n", $expr.value);}
  | ^('=' ID expr) {
      char *c = $ID.text->chars;
      memory->put(memory, c, $expr.value);
      printf("list[put]: '\%s'=\%d\n", c, $expr.value);
    }
  ;

expr returns [int value]
  : ^('+' a=expr b=expr) {$value = a+b;}
  | ^('-' a=expr b=expr) {$value = a-b;}   
  | ^('*' a=expr b=expr) {$value = a*b;}
  | ID {
    char *c = $ID.text->chars;
    result_int v = memory->get(memory, c);
    if (v.code) {
      printf("list[get]: undefined '\%s'\n", c);
    } else {
      printf("list[get]: \%d<-'\%s'\n", v.value, c);
      $value = v.value;
    }
  }
  | INT {
    $value = atoi($INT.text->chars);
    printf("d: \%d\n", $value);
    }
  ;
 
