tree grammar HirBuilder;

options {
  language = C;
  tokenVocab = Main;
  ASTLabelType = pANTLR3_BASE_TREE;
}


@header {
#include "util/log.h"
#include "antlr3/antlr3.h"
#include "hir/build_int.h"
}

@members {
}

// SOURCES
source
  : ^(ROOT source_item*)
  ;

source_item
  : func_def
  ;


// TYPES
type_ref returns [type_base *v]
  : ^(TYPE t='bool')  { $v = hir_build_type_bool(ANTLR3_USERP(), $t); }
  | ^(TYPE t='byte')  { $v = hir_build_type_byte(ANTLR3_USERP(), $t); }
  | ^(TYPE t='int')   { $v = hir_build_type_int(ANTLR3_USERP(), $t); }
  | ^(TYPE t='uint')  { $v = hir_build_type_uint(ANTLR3_USERP(), $t); }
  | ^(TYPE t='long')  { $v = hir_build_type_long(ANTLR3_USERP(), $t); }
  | ^(TYPE t='ulong') { $v = hir_build_type_ulong(ANTLR3_USERP(), $t); }
  | ^(TYPE t='char')  { $v = hir_build_type_char(ANTLR3_USERP(), $t); }
  | ^(TYPE t='string'){ $v = hir_build_type_string(ANTLR3_USERP(), $t); }
  | ^(TYPE id=identifier) { $v = (type_base *) hir_build_type_custom(ANTLR3_USERP(), $id.v); }
  | ^(TYPE ^(r='array' tr=type_ref ^(ELEMS  ','*)))
    { $v = (type_base *) hir_build_type_array(ANTLR3_USERP(), $r, $ELEMS, $tr.v); }
  ;


// FUNCTIONS
func_def
  @init {
    list_hir_var *vars = NULL;
    void *block = NULL;
  }
  : ^(FUNC
      func_signature[$FUNC]
      (^(BODY
        ^(VARS { vars = list_hir_var_new(); } (func_body_var {
            hir_build_body_var_extend(ANTLR3_USERP(), vars, $func_body_var.v);
          }) *)
        (statement_block) { block = $statement_block.v; }
      ))?
    ) {
    hir_build_func(ANTLR3_USERP(), $func_signature.v, vars, block);
  }
  ;

func_signature [void *FUNC_n] returns [ hir_subroutine *v ]
  @init {
    type_base *type_ref_v = NULL;
  }
  : id=identifier params=param_def_list
      ^(RETURNS (type_ref { type_ref_v = $type_ref.v; })?)
      {
    $v = hir_build_signature(ANTLR3_USERP(), $FUNC_n, $id.v, $params.v, type_ref_v);
  }
  ;

param_def_list returns [ list_hir_param *v ]
  @init {
    list_hir_param *ret_v = list_hir_param_new();
  }
  : ^(PARAMS (param_def { list_hir_param_push_back(ret_v, $param_def.v); })*) {
    $v = ret_v;
  }
  ;

param_def returns [ hir_param *v ]
  @init {
    type_base *type_ref_v = NULL;
  }
  : ^(PARAM identifier (type_ref { type_ref_v = $type_ref.v; })?) {
    $v = hir_build_param(ANTLR3_USERP(), $identifier.v, type_ref_v);
  }
  ;

func_body_var returns [ list_hir_var *v ]
  @init {
    type_base *tr_v = NULL;
    list_hir_id *ids = list_hir_id_new();
  }
  : ^(VAR (type_ref { tr_v = $type_ref.v; })? (identifier {
        list_hir_id_push_back(ids, $identifier.v);
      } )*
    ) {
    $v = hir_build_body_var(ANTLR3_USERP(), ids, tr_v);
  }
  ;


//STATEMENTS
statement
  : (statement_if
  | statement_block
  | statement_while
  | statement_do
  | statement_break
  | statement_expression)
  ;

statement_if
  @init {
  }
  : ^('if' expr statement (statement)?)
  ;

statement_block returns [ void *v ]
  @init {
  }
  : ^('begin' (statement)*) {
    $v = NULL;
  }
  ;

statement_while
  @init {
  }
  : ^('while' expr statement)
  ;

statement_do
  @init {
  }
  : ^('repeat' statement_do_condition statement)
  ;

statement_do_condition
  : ^('while' expr)
  | ^('until' expr)
  ;

statement_break
  @init {
  }
  : 'break'
  ;

statement_expression
  @init {
  }
  : expr
  ;


// EXPRESSIONS
expr
  : (expr_14
  | expr_12
  | expr_11
  | expr_10
  | expr_9
  | expr_8
  | expr_7
  | expr_6
  | expr_5
  | expr_4
  | expr_3
  | expr_2
  | expr_caller
  | expr_indexer
  | expr_literal
  | expr_identifier)
  ;


// OPERATORS
expr_15
  : (expr)*
  ;

expr_14
  : ^('=' expr expr)
  ;

expr_12
  : ^('||' expr expr)
  ;

expr_11
  : ^('&&' expr expr)
  ;

expr_10
  : ^('|' expr expr)
  ;

expr_9
  : ^('^' expr expr)
  ;

expr_8
  : ^('&' expr expr)
  ;

expr_7
  : ^('==' expr expr)
  | ^('!=' expr expr)
  ;

expr_6
  : ^('<' expr expr)
  | ^('<=' expr expr)
  | ^('>' expr expr)
  | ^('>=' expr expr)
  ;

expr_5
  : ^('<<' expr expr)
  | ^('>>' expr expr)
  ;

expr_4
  @init {
  }
  : ^('+' expr (expr)?)
  | ^('-' expr (expr)?)
  ;

expr_3
  : ^('*' expr expr)
  | ^('/' expr expr)
  | ^('%' expr expr)
  ;

// NOTE: excluding unary +/-
expr_2
  : ^('--' expr)
  | ^('++' expr)
  | ^('!' expr)
  | ^('~' expr)
  ;

expr_caller
  @init {
  }
  : ^(CALLER ^(ARGS expr_15) expr)
  ;

expr_indexer
  @init {
  }
  : ^(INDEXER ^(ARGS expr_15) expr)
  ;

expr_literal
  : (bool | str | rune | hex | bits | dec)
  ;

expr_identifier
  : identifier
  ;


// TERMINALS
identifier returns [hir_id *v]
  : c=IDENTIFIER { $v = hir_build_id(ANTLR3_USERP(), $c); }
  ;

str returns [hir_lit *v]
  : ^(CONST_STR c=STR { $v = hir_build_str(ANTLR3_USERP(), $c); })
  ;

rune returns [hir_lit *v]
  : ^(CONST_CHAR c=CHAR { $v = hir_build_rune(ANTLR3_USERP(), $c); })
  ;

hex returns [hir_lit *v]
  : ^(CONST_HEX c=HEX) { $v = hir_build_hex(ANTLR3_USERP(), $c); }
  ;

bits returns [hir_lit *v]
  : ^(CONST_BITS c=BITS) { $v = hir_build_bits(ANTLR3_USERP(), $c); }
  ;

dec returns [hir_lit *v]
  : ^(CONST_DEC c=DEC) { $v = hir_build_dec(ANTLR3_USERP(), $c); }
  ;

bool returns [hir_lit *v]
  : ^(CONST_BOOL c=BOOL) { $v = hir_build_bool(ANTLR3_USERP(), $c); }
  ;
