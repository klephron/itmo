grammar Option2;

options {
  language=C;
  output=AST;
  ASTLabelType = pANTLR3_BASE_TREE;
}

source
  : identifier '=' str NEWLINE
  ;


identifier: IDENTIFIER;

str: STR;
rune: CHAR;
hex: HEX;
bits: BITS;
dec: DEC;
bool: BOOL;


BOOL: (TRUE | FALSE) ;
IDENTIFIER: (ALPHA | SPECIAL) (ALPHA | SPECIAL | DIGIT)* ;
BITS: '0' ('b'|'B') BINARY_DIGIT+ ;
HEX: '0'('x'|'X') HEX_DIGIT+ ;
DEC: DIGIT+ ;
CHAR: '\'' ~('\'') '\'' ;
STR: ('"') ('\\' . | ~('\\'|'"'))* ('"') ;

NEWLINE:'\r'? '\n' ;
WSS: WS+ { SKIP(); };


fragment TRUE: 'true';
fragment FALSE: 'false';
fragment ALPHA: ('a'..'z' | 'A'..'Z');
fragment SPECIAL: ('_');
fragment DIGIT: ('0'..'9');
fragment BINARY_DIGIT: ('0' | '1');
fragment HEX_DIGIT: ('0'..'9' | 'a'..'f' | 'A'..'F');
fragment WS:(' '|'\t') ;

