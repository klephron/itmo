grammar Option2;

options {
  language=C;
  output=AST;
  ASTLabelType = pANTLR3_BASE_TREE;
}

tokens {
  VARS;
  VAR;
  FUNC;
  ARGS;
  ELEMS;
  RETURNS;
  BODY;
  CALLER;
  INDEXER;
  CONST_BOOL;
  CONST_BITS;
  CONST_HEX;
  CONST_DEC;
  CONST_CHAR;
  CONST_STR;
}


// SOURCES
source
  : source_item+ ;

source_item
  : func_def
  ;


// TYPES
type_ref
  : 'bool' | 'byte' | 'int' | 'uint' | 'long' | 'ulong' | 'char' | 'string'
  | identifier
  | arr='array' '[' (elems+=',')* ']' 'of' type_ref -> ^('array' ^(type_ref) ^(ELEMS)) // reference using `elems*`
  ;


// FUNCTIONS
func_def
  : ls='method' func_signature (func_body | ';') -> ^(FUNC[$ls, "FUNC"] func_signature ^(BODY func_body)? )
  ;

func_signature
  : identifier '(' arg_def_list ')' (':' type_ref?) -> identifier arg_def_list ^(RETURNS type_ref?)
  ;

arg_def_list
  : ls=arg_def (',' arg_def)*  -> ^(ARGS arg_def*)
  |                            -> ^(ARGS )
  ;

arg_def
  : identifier (':' type_ref)? -> ^(type_ref identifier)
  ;

func_body
  : ('var' func_body_var * ) statement_block -> ^(VARS (func_body_var)* ) ^(statement_block)
  | statement_block -> ^(VARS ) ^(statement_block)
  ;

func_body_var
  : ( identifier (',' identifier)* (':' type_ref)? ';' ) -> ^(VAR identifier type_ref?)*
  ;


// STATEMENTS
statement
  : statement_if
  | statement_block
  | statement_while
  | statement_do
  | statement_break
  | statement_expression
  ;

statement_if
  : 'if' expr 'then' st_then=statement ('else' st_else=statement)? -> ^('if' expr $st_then $st_else?)
  ;

statement_block
  : 'begin' statement* 'end' ';' -> ^('begin' statement*)
  ;
  
statement_while
  : 'while' expr 'do' statement -> ^('while' expr statement)
  ;

statement_do
  : 'repeat' statement statement_do_condition -> ^('repeat' statement_do_condition statement)
  ;

statement_do_condition
  : 'while'^ expr ';'!
  | 'until'^ expr ';'!
  ;

statement_break
  : 'break' ';' -> ^('break')
  ;

statement_expression
  : expr ';' -> ^(expr)
  ;


// EXPRESSIONS
expr
  : expr_list
  ;

expr_literal
  : bool | str | rune | hex | bits | dec
  ;

// OPERATORS
// (priority 15-lowest)
expr_list
  : ((expr_unary | expr_binary_14) (','^ (expr_unary | expr_binary_14) )* )? 
  ;

caller_indexer
  : '(' expr_list ')' -> ^(CALLER expr_list)
  | '[' expr_list ']' -> ^(INDEXER expr_list)
  ;

// (priority 0-1) braces or call/index 
expr_braces_caller_indexer
  : '('! expr ')'! caller_indexer^?
  ;

// (priority 0-1) identifier or call/index 
expr_place_caller_indexer
  : identifier caller_indexer^?
  ;

// (root)
expr_unary
  : '!' expr -> ^('!' expr)
  ;

// tail recursion
expr_binary_14
  : expr_binary_12 ('='^ expr_binary_14)?
  ;

expr_binary_12
  : expr_binary_11 ('||'^ expr_binary_11)*
  ;

expr_binary_11
  : expr_binary_10 ('&&'^ expr_binary_10)*
  ;

expr_binary_10
  : expr_binary_9 ('|'^ expr_binary_9)*
  ;

expr_binary_9
  : expr_binary_8 ('^'^ expr_binary_8)*
  ;

expr_binary_8
  : expr_binary_7 ('&'^ expr_binary_7)*
  ;

expr_binary_7
  : expr_binary_6 (('==' | '!=')^ expr_binary_6)*
  ;

expr_binary_6
  : expr_binary_5 (('<' | '<=' | '>' | '>=')^ expr_binary_5)*
  ;

expr_binary_5
  : expr_binary_4 (('>>' | '<<')^ expr_binary_4)*
  ;

expr_binary_4
  : expr_binary_3 (('+' | '-')^ expr_binary_3)*
  ;

expr_binary_3
  : expr_binary_01 (('*' | '/' | '%')^ expr_binary_01)*
  ;

expr_binary_01
  : expr_literal | expr_place_caller_indexer | expr_braces_caller_indexer
  ;


// TERMINALS
identifier: IDENTIFIER;

str: STR -> ^(CONST_STR STR);
rune: CHAR -> ^(CONST_CHAR CHAR);
hex: HEX -> ^(CONST_HEX HEX); 
bits: BITS -> ^(CONST_BITS BITS);
dec: DEC -> ^(CONST_DEC DEC);
bool: BOOL -> ^(CONST_BOOL BOOL);


BOOL: (TRUE | FALSE) ;
IDENTIFIER: (ALPHA | SPECIAL) (ALPHA | SPECIAL | DIGIT)* ;
BITS: '0' ('b'|'B') BINARY_DIGIT+ ;
HEX: '0'('x'|'X') HEX_DIGIT+ ;
DEC: DIGIT+ ;
CHAR: '\'' ~('\'') '\'' ;
STR: ('"') ('\\' . | ~('\\'|'"'))* ('"') ;

NEWLINE:'\r'? '\n' { SKIP(); };
WSS: WS+ { SKIP(); };


fragment TRUE: 'true';
fragment FALSE: 'false';
fragment ALPHA: ('a'..'z' | 'A'..'Z');
fragment SPECIAL: ('_');
fragment DIGIT: ('0'..'9');
fragment BINARY_DIGIT: ('0' | '1');
fragment HEX_DIGIT: ('0'..'9' | 'a'..'f' | 'A'..'F');
fragment WS:(' '|'\t') ;

