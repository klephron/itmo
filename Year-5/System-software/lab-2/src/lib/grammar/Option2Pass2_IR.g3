tree grammar Option2Pass2_IR;

options {
  language = C;
  tokenVocab = Option2;
  ASTLabelType = pANTLR3_BASE_TREE;
}


@header {
#include "util/log.h"
#include "ir/antlr3.h"
#include "ir/expr.h"
#include "ir/subroutine.h"
#include "ir/terminal.h"
#include "ir/type.h"
#include "ir/pass2.h"
}

@members {
}


// SOURCES
source
  : ^(ROOT source_item*)
  ;

source_item
  : func_def {
      ir_pass2_subroutine_add(IR_PASS2_ANTLR3_USERP(), $func_def.v);
    }
  ;


// TYPES
type_ref returns [ir_t_base *v]
  : ^(TYPE 'bool')  { $v = ir_pass2_t_bool_new(IR_PASS2_ANTLR3_USERP()); }
  | ^(TYPE 'byte')  { $v = ir_pass2_t_byte_new(IR_PASS2_ANTLR3_USERP()); }
  | ^(TYPE 'int')   { $v = ir_pass2_t_int_new(IR_PASS2_ANTLR3_USERP()); }
  | ^(TYPE 'uint')  { $v = ir_pass2_t_uint_new(IR_PASS2_ANTLR3_USERP()); }
  | ^(TYPE 'long')  { $v = ir_pass2_t_long_new(IR_PASS2_ANTLR3_USERP()); }
  | ^(TYPE 'ulong') { $v = ir_pass2_t_ulong_new(IR_PASS2_ANTLR3_USERP()); }
  | ^(TYPE 'char')  { $v = ir_pass2_t_char_new(IR_PASS2_ANTLR3_USERP()); }
  | ^(TYPE 'string'){ $v = ir_pass2_t_string_new(IR_PASS2_ANTLR3_USERP()); }

  | ^(TYPE identifier) {
    $v = ir_pass2_t_custom_new(IR_PASS2_ANTLR3_USERP(), $identifier.v);
  }

  | ^(TYPE ^('array' tr=type_ref ^(ELEMS  ','*))) {
    size_t dimension = IR_ANTLR3_SIZE($ELEMS) + 1;
    $v = ir_pass2_t_array_new(IR_PASS2_ANTLR3_USERP(), dimension, $tr.v);
  }
  ;


// FUNCTIONS
func_def returns [ir_subroutine *v]
  @init {
    p_list func_body_v = NULL;
    ir_block_base *func_body_cfg = NULL;
  }
  : ^(FUNC func_signature (^(BODY func_body[$func_signature.v] {
      func_body_v = $func_body.v;
      func_body_cfg = $func_body.cfg;
    }))? ) {
      $v = ir_pass2_subroutine_new(IR_PASS2_ANTLR3_USERP(), $func_signature.v, func_body_v, func_body_cfg);
    }
  ;

func_signature returns [ir_signature *v]
  @init {
    ir_t_base *ret_v = NULL;
  }
  : id=identifier al=arg_def_list ^(RETURNS (r=type_ref { ret_v = $r.v; })?) {
      $v = ir_pass2_signature_new(IR_PASS2_ANTLR3_USERP(), $id.v, $al.v, ret_v);
    }
  ;

arg_def_list returns [p_list v]
  @init {
    p_list params = ir_pass2_params_new(IR_PASS2_ANTLR3_USERP());
  }
  : ^(PARAMS (arg_def {
      ir_pass2_param_add(IR_PASS2_ANTLR3_USERP(), params, $arg_def.v);
    })*) {
    $v = params;
  }
  ;

arg_def returns [ir_var *v]
  @init {
    void *type_ref_v = NULL;
  }
  : ^(PARAM id=identifier (type_ref { type_ref_v = $type_ref.v; })?) {
      $v = ir_pass2_param_new(IR_PASS2_ANTLR3_USERP(), $id.v, type_ref_v);
    }
  ;

func_body  [ir_signature *sign] returns [p_list v, ir_block_base *cfg]
  @init {
    p_list vars = ir_pass2_vars_new(IR_PASS2_ANTLR3_USERP());
    ir_block_base *cfg = NULL;
  }
  : ^(VARS (func_body_var { ir_pass2_vars_add(IR_PASS2_ANTLR3_USERP(), vars, $func_body_var.v); })* )
      { ir_pass2_body_before(IR_PASS2_ANTLR3_USERP(), sign, vars); }
      (st=statement_block { cfg = ir_pass2_body_build(IR_PASS2_ANTLR3_USERP(), $st.v); }) {
        $v = vars;
        $cfg = cfg;
      }
  ;

func_body_var returns [p_list v]
  @init  {
    void *type_ref_v = NULL;
    p_list ids = ir_pass2_ids_new(IR_PASS2_ANTLR3_USERP());
  }
  : ^(VAR (type_ref { type_ref_v = $type_ref.v; })? (identifier {
      ir_pass2_id_add(IR_PASS2_ANTLR3_USERP(), ids, $identifier.v);
    })*) {
    $v = ir_pass2_var_new(IR_PASS2_ANTLR3_USERP(), ids, type_ref_v);
  }
  ;


//STATEMENTS
statement returns [ir_scope *v]
  : (st=statement_if
  | st=statement_block
  | st=statement_while
  | st=statement_do
  | st=statement_break
  | st=statement_expression) { $v = $st.v; }
  ;

statement_if returns [ir_scope *v]
  @init {
    ir_pass2_if_before(IR_PASS2_ANTLR3_USERP());
    ir_scope *else_st_v = NULL;
  }
  : ^('if' expr then_st=statement (else_st=statement { else_st_v = $else_st.v; })?) {
    $v = ir_pass2_if_build(IR_PASS2_ANTLR3_USERP(), $expr.v, $then_st.v, else_st_v);
  }
  ;

statement_block returns [ir_scope *v]
  @init {
    ir_pass2_block_before(IR_PASS2_ANTLR3_USERP());
    p_list scopes = ir_pass2_scope_list_new(IR_PASS2_ANTLR3_USERP());
  }
  : ^('begin' (statement { ir_pass2_scope_add(IR_PASS2_ANTLR3_USERP(), scopes, $statement.v); })*) {
    $v =  ir_pass2_block_build(IR_PASS2_ANTLR3_USERP(), scopes);
  }
  ;

statement_while returns [ir_scope *v]
  @init {
    ir_pass2_while_before(IR_PASS2_ANTLR3_USERP());
  }
  : ^('while' expr statement) {
    $v = ir_pass2_while_build(IR_PASS2_ANTLR3_USERP(), $expr.v, $statement.v);
  }
  ;

statement_do returns [ir_scope *v]
  @init {
    ir_pass2_do_before(IR_PASS2_ANTLR3_USERP());
  }
  : ^('repeat' cond=statement_do_condition statement) {
    $v = ir_pass2_do_build(IR_PASS2_ANTLR3_USERP(), $cond.v, $cond.p, $statement.v);
  }
  ;

statement_do_condition returns [ir_expr_base *v, int p]
  : ^('while' expr) { $v = $expr.v; $p = 1; }
  | ^('until' expr) { $v = $expr.v; $p = 0; }
  ;

statement_break returns [ir_scope *v]
  @init {
    ir_pass2_break_before(IR_PASS2_ANTLR3_USERP());
  }
  : 'break' {
    $v = ir_pass2_break_build(IR_PASS2_ANTLR3_USERP());
  }
  ;

statement_expression returns [ir_scope *v]
  @init {
    ir_pass2_expression_before(IR_PASS2_ANTLR3_USERP());
  }
  : expr {
    $v = ir_pass2_expression_build(IR_PASS2_ANTLR3_USERP(), $expr.v);
  }
  ;


// EXPRESSIONS
expr returns [ir_expr_base *v]
  : (ex=expr_14
  | ex=expr_12
  | ex=expr_11
  | ex=expr_10
  | ex=expr_9
  | ex=expr_8
  | ex=expr_7
  | ex=expr_6
  | ex=expr_5
  | ex=expr_4
  | ex=expr_3
  | ex=expr_2
  | ex=expr_caller
  | ex=expr_indexer
  | ex=expr_literal
  | ex=expr_identifier) { $v = (ir_expr_base *) $ex.v; }
  ;


// OPERATORS
expr_15 [p_list args]
  : (expr { list_push_back($args, $expr.v); })*
  ;

expr_14 returns [ir_expr_base *v]
  : ^(id='=' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_ASSIGN, ir_loc_antlr3($id)); }
  ;

expr_12 returns [ir_expr_base *v]
  : ^(id='||' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_LOGICAL_OR, ir_loc_antlr3($id)); }
  ;

expr_11 returns [ir_expr_base *v]
  : ^(id='&&' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_LOGICAL_AND, ir_loc_antlr3($id)); }
  ;

expr_10 returns [ir_expr_base *v]
  : ^(id='|' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_BITWISE_OR, ir_loc_antlr3($id)); }
  ;

expr_9 returns [ir_expr_base *v]
  : ^(id='^' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_BITWISE_XOR, ir_loc_antlr3($id)); }
  ;

expr_8  returns [ir_expr_base *v]
  : ^(id='&' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_BITWISE_AND, ir_loc_antlr3($id)); }
  ;

expr_7 returns [ir_expr_base *v]
  : ^(id='==' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_EQUALS, ir_loc_antlr3($id)); }
  | ^(id='!=' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_NOT_EQUALS, ir_loc_antlr3($id)); }
  ;

expr_6 returns [ir_expr_base *v]
  : ^(id='<' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_LESS, ir_loc_antlr3($id)); }
  | ^(id='<=' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_LESS_EQUALS, ir_loc_antlr3($id)); }
  | ^(id='>' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_GREATER, ir_loc_antlr3($id)); }
  | ^(id='>=' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_GREATER_EQUALS, ir_loc_antlr3($id)); }
  ;

expr_5 returns [ir_expr_base *v]
  : ^(id='<<' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_BITWISE_SHIFT_LEFT, ir_loc_antlr3($id)); }
  | ^(id='>>' e2=expr e1=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_BITWISE_SHIFT_RIGHT, ir_loc_antlr3($id)); }
  ;

expr_4 returns [ir_expr_base *v]
  @init {
    void *e2_v = NULL;
  }
  : ^(id='+' e1=expr (e2=expr {e2_v = $e2.v;})?) {
    if (e2_v) {
      $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, e2_v, IR_EXPR_BINARY_ADD, ir_loc_antlr3($id));
    } else {
      $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, IR_EXPR_UNARY_PLUS, ir_loc_antlr3($id));
    }
  }
  | ^(id='-' e1=expr (e2=expr {e2_v = $e2.v;})?) {
    if (e2_v) {
      $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, e2_v, IR_EXPR_BINARY_SUB, ir_loc_antlr3($id));
    } else {
      $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, IR_EXPR_UNARY_MINUS, ir_loc_antlr3($id));
    }
  }
  ;

expr_3 returns [ir_expr_base *v]
  : ^(id='*' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_MUL, ir_loc_antlr3($id)); }
  | ^(id='/' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_DIV, ir_loc_antlr3($id)); }
  | ^(id='%' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_MOD, ir_loc_antlr3($id)); }
  ;

// NOTE: excluding unary +/-
expr_2 returns [ir_expr_base *v]
  : ^(id='--' expr) { $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $expr.v, IR_EXPR_UNARY_DEC, ir_loc_antlr3($id)); }
  | ^(id='++' expr) { $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $expr.v, IR_EXPR_UNARY_INC, ir_loc_antlr3($id)); }
  | ^(id='!' expr) { $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $expr.v, IR_EXPR_UNARY_LOGICAL_NOT, ir_loc_antlr3($id)); }
  | ^(id='~' expr) { $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $expr.v, IR_EXPR_UNARY_BITWISE_NOT, ir_loc_antlr3($id)); }
  ;

expr_caller returns [ir_expr_base *v]
  @init {
    p_list args = ir_expr_list_new();
  }
  : ^(CALLER ^(ARGS expr_15[args]) expr) {
    $v = ir_pass2_expr_call_new(IR_PASS2_ANTLR3_USERP(), $expr.v, args);
  }
  ;

expr_indexer returns [ir_expr_base *v]
  @init {
    p_list args = ir_expr_list_new();
  }
  : ^(INDEXER ^(ARGS expr_15[args]) expr) {
    $v = ir_pass2_expr_index_new(IR_PASS2_ANTLR3_USERP(), $expr.v, args);
  }
  ;

expr_literal returns [ir_expr_base *v]
  : (id=bool | id=str | id=rune | id=hex | id=bits | id=dec) {
    $v = ir_pass2_expr_lit_new(IR_PASS2_ANTLR3_USERP(), $id.v);
  }
  ;

expr_identifier returns [ir_expr_base *v]
  : identifier {
      $v = ir_pass2_expr_id_new(IR_PASS2_ANTLR3_USERP(), $identifier.v);
    }
  ;


// TERMINALS
identifier returns [ir_term_id *v]
  : id=IDENTIFIER {
    $v = ir_pass2_term_id_new(IR_PASS2_ANTLR3_USERP(), ir_loc_antlr3($id), IR_ANTLR3_CHARS($id));
  };

str returns [ir_term_lit *v]
  : ^(CONST_STR id=STR) {
    $v = ir_pass2_str(IR_PASS2_ANTLR3_USERP(), ir_loc_antlr3($id), IR_ANTLR3_CHARS($id));
  };
rune returns [ir_term_lit *v]
  : ^(CONST_CHAR id=CHAR) {
    $v = ir_pass2_rune(IR_PASS2_ANTLR3_USERP(), ir_loc_antlr3($id), IR_ANTLR3_CHARS($id));
  };
hex returns [ir_term_lit *v]
  : ^(CONST_HEX id=HEX) {
    $v = ir_pass2_hex(IR_PASS2_ANTLR3_USERP(), ir_loc_antlr3($id), IR_ANTLR3_CHARS($id));
  };
bits returns [ir_term_lit *v]
  : ^(CONST_BITS id=BITS) {
    $v = ir_pass2_bits(IR_PASS2_ANTLR3_USERP(), ir_loc_antlr3($id), IR_ANTLR3_CHARS($id));
  };
dec returns [ir_term_lit *v]
  : ^(CONST_DEC id=DEC) {
    $v = ir_pass2_dec(IR_PASS2_ANTLR3_USERP(), ir_loc_antlr3($id), IR_ANTLR3_CHARS($id));
  };
bool returns [ir_term_lit *v]
  : ^(CONST_BOOL id=BOOL) {
    $v = ir_pass2_bool(IR_PASS2_ANTLR3_USERP(), ir_loc_antlr3($id), IR_ANTLR3_CHARS($id));
  };
