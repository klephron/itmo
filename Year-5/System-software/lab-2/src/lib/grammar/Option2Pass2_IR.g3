tree grammar Option2Pass2_IR;

options {
  language = C;
  tokenVocab = Option2;
  ASTLabelType = pANTLR3_BASE_TREE;
}


@header {
#include "ir/expr.h"
#include "ir/function.h"
#include "ir/statement.h"
#include "ir/terminal.h"
#include "ir/type.h"
#include "ir/pass2.h"
}

@members {
}


// SOURCES
source
  @init {

  }
  @after {
  }
  : ^(ROOT source_item*)
  ;

source_item
  : func_def
  ;


// TYPES
type_ref
  : 'bool' | 'byte' | 'int' | 'uint' | 'long' | 'ulong' | 'char' | 'string'
  | identifier
  |  ^('array' type_ref ^(ELEMS ','*))
  ;


// FUNCTIONS
func_def
  : ^(FUNC func_signature (^(BODY func_body))? )
  ;

func_signature
  : identifier arg_def_list ^(RETURNS type_ref?)
  ;

arg_def_list
  : ^(PARAMS arg_def*)
  ;

arg_def
  : ^(PARAM identifier type_ref?)
  ;

func_body
  : ^(VARS func_body_var*) statement_block
  ;

func_body_var
  : ^(VAR identifier type_ref?)
  ;


//STATEMENTS
statement
  : statement_if
  | statement_block
  | statement_while
  | statement_do
  | statement_break
  | statement_expression
  ;

statement_if
  : ^('if' expr statement statement?)
  ;

statement_block
  : ^('begin' statement*)
  ;

statement_while
  : ^('while' expr statement)
  ;

statement_do
  : ^('repeat' statement_do_condition statement)
  ;

statement_do_condition
  : ^('while' expr)
  | ^('until' expr)
  ;

statement_break
  : 'break'
  ;

statement_expression
  : expr
  ;


// EXPRESSIONS
expr
  : expr_14
  | expr_12
  | expr_11
  | expr_10
  | expr_9
  | expr_8
  | expr_7
  | expr_6
  | expr_5
  | expr_4
  | expr_3
  | expr_2
  | expr_caller
  | expr_indexer
  | expr_literal
  | expr_identifier
  ;


// OPERATORS
expr_15
  : expr*
  ;

expr_14
  : ^('=' expr expr)
  ;

expr_12
  : ^('||' expr expr)
  ;

expr_11
  : ^('&&' expr expr)
  ;

expr_10
  : ^('|' expr expr)
  ;

expr_9
  : ^('^' expr expr)
  ;

expr_8
  : ^('&' expr expr)
  ;

expr_7
  : ^('==' expr expr)
  | ^('!=' expr expr)
  ;

expr_6
  : ^('<' expr expr)
  | ^('<=' expr expr)
  | ^('>' expr expr)
  | ^('>=' expr expr)
  ;

expr_5
  : ^('<<' expr expr)
  | ^('>>' expr expr)
  ;

expr_4
  : ^('+' expr expr?)
  | ^('-' expr expr?)
  ;

expr_3
  : ^('*' expr expr)
  | ^('/' expr expr)
  | ^('%' expr expr)
  ;

// NOTE: excluding unary +/-
expr_2
  : ^('--' expr)
  | ^('++' expr)
  | ^('!' expr)
  | ^('~' expr)
  ;

expr_caller
  : ^(CALLER ^(ARGS expr_15) expr)
  ;

expr_indexer
  : ^(INDEXER ^(ARGS expr_15) expr)
  ;

expr_literal returns [ir_expr_lit *v]
  : (id=bool | id=str | id=rune | id=hex | id=bits | id=dec) {
    $v = ir_expr_lit_new($id.v);
  }
  ;

expr_identifier returns [ir_expr_id *v]
  : identifier {
      $v = ir_expr_id_new($identifier.v);
    }
  ;


// TERMINALS
identifier returns [ir_term_id *v]
  : id=IDENTIFIER {
    $v = ir_term_id_new(IR_PASS2_CHARS($id));
  };

str returns [ir_term_lit *v]
  : ^(CONST_STR id=STR) {
    $v = ir_pass2_str(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
rune returns [ir_term_lit *v]
  : ^(CONST_CHAR id=CHAR) {
    $v = ir_pass2_rune(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
hex returns [ir_term_lit *v]
  : ^(CONST_HEX id=HEX) {
    $v = ir_pass2_hex(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
bits returns [ir_term_lit *v]
  : ^(CONST_BITS id=BITS) {
    $v = ir_pass2_bits(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
dec returns [ir_term_lit *v]
  : ^(CONST_DEC id=DEC) {
    $v = ir_pass2_dec(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
bool returns [ir_term_lit *v]
  : ^(CONST_BOOL id=BOOL) {
    $v = ir_pass2_bool(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
