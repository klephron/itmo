tree grammar Option2Pass2_IR;

options {
  language = C;
  tokenVocab = Option2;
  ASTLabelType = pANTLR3_BASE_TREE;
}


@header {
#include "util/log.h"
#include "ir/expr.h"
#include "ir/function.h"
#include "ir/terminal.h"
#include "ir/type.h"
#include "ir/pass2.h"
}

@members {
}


// SOURCES
source
  : ^(ROOT source_item*)
  ;

source_item
  : func_def {
      ir_pass2_subroutine_add(IR_PASS2_ANTLR3_USERP(), $func_def.v);
    }
  ;


// TYPES
type_ref returns [ir_t_base *v]
  : 'bool'  { $v = ir_pass2_t_bool_new(IR_PASS2_ANTLR3_USERP()); }
  | 'byte'  { $v = ir_pass2_t_byte_new(IR_PASS2_ANTLR3_USERP()); }
  | 'int'   { $v = ir_pass2_t_int_new(IR_PASS2_ANTLR3_USERP()); }
  | 'uint'  { $v = ir_pass2_t_uint_new(IR_PASS2_ANTLR3_USERP()); }
  | 'long'  { $v = ir_pass2_t_long_new(IR_PASS2_ANTLR3_USERP()); }
  | 'ulong' { $v = ir_pass2_t_ulong_new(IR_PASS2_ANTLR3_USERP()); }
  | 'char'  { $v = ir_pass2_t_char_new(IR_PASS2_ANTLR3_USERP()); }
  | 'string'{ $v = ir_pass2_t_string_new(IR_PASS2_ANTLR3_USERP()); }

  | identifier {
    $v = ir_pass2_t_custom_new(IR_PASS2_ANTLR3_USERP(), $identifier.v);
  }

  | ^('array' tr=type_ref ^(ELEMS  ','*)) {
    size_t dimension = IR_PASS2_SIZE($ELEMS) + 2;
    $v = ir_pass2_t_array_new(IR_PASS2_ANTLR3_USERP(), dimension, $tr.v);
  }
  ;


// FUNCTIONS
func_def returns [ir_subroutine *v]
  @init {
    p_hashset func_body_v = NULL;
    ir_block_base *func_body_s = NULL;
  }
  : ^(FUNC func_signature (^(BODY func_body {
      func_body_v = $func_body.v;
    }))? ) {
      $v = ir_pass2_subroutine_new(IR_PASS2_ANTLR3_USERP(), $func_signature.v, func_body_v);
    }
  ;

func_signature returns [ir_signature *v]
  @init {
    ir_t_base *ret_v = NULL;
  }
  : id=identifier al=arg_def_list ^(RETURNS (r=type_ref { ret_v = $r.v; })?) {
      $v = ir_pass2_signature_new(IR_PASS2_ANTLR3_USERP(), $id.v, $al.v, ret_v);
    }
  ;

arg_def_list returns [p_list v]
  @init {
    p_list params = ir_pass2_params_new(IR_PASS2_ANTLR3_USERP());
  }
  : ^(PARAMS (arg_def {
      ir_pass2_param_add(IR_PASS2_ANTLR3_USERP(), params, $arg_def.v);
    })*) {
    $v = params;
  }
  ;

arg_def returns [ir_var *v]
  @init {
    void *type_ref_v = NULL;
  }
  : ^(PARAM id=identifier (type_ref { type_ref_v = $type_ref.v; })?) {
      $v = ir_pass2_param_new(IR_PASS2_ANTLR3_USERP(), $id.v, type_ref_v);
    }
  ;

func_body returns [p_hashset v]
  @init {
    p_hashset vars = ir_pass2_vars_new(IR_PASS2_ANTLR3_USERP());
    ir_pass2_body_before(IR_PASS2_ANTLR3_USERP());
  }
  @after {
    ir_pass2_body_after(IR_PASS2_ANTLR3_USERP());
  }
  : ^(VARS (func_body_var {
      ir_pass2_vars_add(IR_PASS2_ANTLR3_USERP(), vars, $func_body_var.v);
    })*) statement_block {
      $v = vars;
  }
  ;

func_body_var returns [p_list v]
  @init  {
    void *type_ref_v = NULL;
    p_list ids = ir_pass2_ids_new(IR_PASS2_ANTLR3_USERP());
  }
  : ^(VAR (type_ref { type_ref_v = $type_ref.v; })? (identifier {
      ir_pass2_id_add(IR_PASS2_ANTLR3_USERP(), ids, $identifier.v);
    })*) {
    $v = ir_pass2_var_new(IR_PASS2_ANTLR3_USERP(), ids, type_ref_v);
  }
  ;


//STATEMENTS
statement
  : statement_if
  | statement_block
  | statement_while
  | statement_do
  | statement_break
  | statement_expression
  ;

statement_if
  : ^('if' expr statement statement?)
  ;

statement_block returns [ir_block_base *v]
  : ^('begin' statement*)
  ;

statement_while
  : ^('while' expr statement)
  ;

statement_do
  : ^('repeat' statement_do_condition statement)
  ;

statement_do_condition
  : ^('while' expr)
  | ^('until' expr)
  ;

statement_break
  : 'break'
  ;

statement_expression
  : expr
  ;


// EXPRESSIONS
expr returns [ir_expr_base *v]
  : (ex=expr_14
  | ex=expr_12
  | ex=expr_11
  | ex=expr_10
  | ex=expr_9
  | ex=expr_8
  | ex=expr_7
  | ex=expr_6
  | ex=expr_5
  | ex=expr_4
  | ex=expr_3
  | ex=expr_2
  | ex=expr_caller
  | ex=expr_indexer
  | ex=expr_literal
  | ex=expr_identifier) { $v = (ir_expr_base *) $ex.v; }
  ;


// OPERATORS
expr_15 returns [p_list v]
  @init {
    p_list args = ir_expr_list_new();
  }
  : (expr { list_push_back(args, $expr.v); })* { $v = args; }
  ;

expr_14 returns [ir_expr_base *v]
  : ^('=' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_ASSIGN); }
  ;

expr_12 returns [ir_expr_base *v]
  : ^('||' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_LOGICAL_OR); }
  ;

expr_11 returns [ir_expr_base *v]
  : ^('&&' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_LOGICAL_AND); }
  ;

expr_10 returns [ir_expr_base *v]
  : ^('|' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_BITWISE_OR); }
  ;

expr_9 returns [ir_expr_base *v]
  : ^('^' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_BITWISE_XOR); }
  ;

expr_8  returns [ir_expr_base *v]
  : ^('&' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_BITWISE_AND); }
  ;

expr_7 returns [ir_expr_base *v]
  : ^('==' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_EQUALS); }
  | ^('!=' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_NOT_EQUALS); }
  ;

expr_6 returns [ir_expr_base *v]
  : ^('<' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_LESS); }
  | ^('<=' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_LESS_EQUALS); }
  | ^('>' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_GREATER); }
  | ^('>=' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_GREATER_EQUALS); }
  ;

expr_5 returns [ir_expr_base *v]
  : ^('<<' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_BITWISE_SHIFT_LEFT); }
  | ^('>>' e2=expr e1=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_BITWISE_SHIFT_RIGHT); }
  ;

expr_4 returns [ir_expr_base *v]
  @init {
    void *e2_v = NULL;
  }
  : ^('+' e1=expr (e2=expr {e2_v = $e2.v;})?) {
    if (e2_v) {
      $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, e2_v, IR_EXPR_BINARY_ADD);
    } else {
      $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, IR_EXPR_UNARY_PLUS);
    }
  }
  | ^('-' e1=expr (e2=expr {e2_v = $e2.v;})?) {
    if (e2_v) {
      $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, e2_v, IR_EXPR_BINARY_SUB);
    } else {
      $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, IR_EXPR_UNARY_MINUS);
    }
  }
  ;

expr_3 returns [ir_expr_base *v]
  : ^('*' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_MUL); }
  | ^('/' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_DIV); }
  | ^('%' e1=expr e2=expr) { $v = ir_pass2_expr_binary_new(IR_PASS2_ANTLR3_USERP(), $e1.v, $e2.v, IR_EXPR_BINARY_MOD); }
  ;

// NOTE: excluding unary +/-
expr_2 returns [ir_expr_base *v]
  : ^('--' expr) { $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $expr.v, IR_EXPR_UNARY_DEC); }
  | ^('++' expr) { $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $expr.v, IR_EXPR_UNARY_INC); }
  | ^('!' expr) { $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $expr.v, IR_EXPR_UNARY_LOGICAL_NOT); }
  | ^('~' expr) { $v = ir_pass2_expr_unary_new(IR_PASS2_ANTLR3_USERP(), $expr.v, IR_EXPR_UNARY_BITWISE_NOT); }
  ;

expr_caller returns [ir_expr_base *v]
  : ^(CALLER ^(ARGS args=expr_15) expr) {
    $v = ir_pass2_expr_call_new(IR_PASS2_ANTLR3_USERP(), $expr.v, $args.v);
  }
  ;

expr_indexer returns [ir_expr_base *v]
  : ^(INDEXER ^(ARGS args=expr_15) expr) {
    $v = ir_pass2_expr_index_new(IR_PASS2_ANTLR3_USERP(), $expr.v, $args.v);
  }
  ;

expr_literal returns [ir_expr_base *v]
  : (id=bool | id=str | id=rune | id=hex | id=bits | id=dec) {
    $v = ir_pass2_expr_lit_new(IR_PASS2_ANTLR3_USERP(), $id.v);
  }
  ;

expr_identifier returns [ir_expr_base *v]
  : identifier {
      $v = ir_pass2_expr_id_new(IR_PASS2_ANTLR3_USERP(), $identifier.v);
    }
  ;


// TERMINALS
identifier returns [ir_term_id *v]
  : id=IDENTIFIER {
    $v = ir_pass2_term_id_new(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };

str returns [ir_term_lit *v]
  : ^(CONST_STR id=STR) {
    $v = ir_pass2_str(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
rune returns [ir_term_lit *v]
  : ^(CONST_CHAR id=CHAR) {
    $v = ir_pass2_rune(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
hex returns [ir_term_lit *v]
  : ^(CONST_HEX id=HEX) {
    $v = ir_pass2_hex(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
bits returns [ir_term_lit *v]
  : ^(CONST_BITS id=BITS) {
    $v = ir_pass2_bits(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
dec returns [ir_term_lit *v]
  : ^(CONST_DEC id=DEC) {
    $v = ir_pass2_dec(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
bool returns [ir_term_lit *v]
  : ^(CONST_BOOL id=BOOL) {
    $v = ir_pass2_bool(IR_PASS2_ANTLR3_USERP(), IR_PASS2_CHARS($id));
  };
