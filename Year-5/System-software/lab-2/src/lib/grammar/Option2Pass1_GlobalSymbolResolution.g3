tree grammar Option2Pass1_GlobalSymbolResolution;

options {
  language = C;
  tokenVocab = Option2;
  ASTLabelType = pANTLR3_BASE_TREE;
}


@header {
#include "util/log.h"
#include "ir/subroutine.h"
#include "ir/terminal.h"
#include "ir/type.h"
#include "ir/pass1.h"
#include "ir/antlr3.h"
}

@members {
}


// SOURCES
source
  : ^(ROOT source_item*)
  ;

source_item
  : func_def {
      ir_pass1_subroutine_add(IR_PASS1_ANTLR3_USERP(), $func_def.v);
    }
  ;


// TYPES
type_ref returns [ir_t_base *v]
  : ^(TYPE 'bool')  { $v = ir_pass1_t_bool_new(IR_PASS1_ANTLR3_USERP()); }
  | ^(TYPE 'byte')  { $v = ir_pass1_t_byte_new(IR_PASS1_ANTLR3_USERP()); }
  | ^(TYPE 'int')   { $v = ir_pass1_t_int_new(IR_PASS1_ANTLR3_USERP()); }
  | ^(TYPE 'uint')  { $v = ir_pass1_t_uint_new(IR_PASS1_ANTLR3_USERP()); }
  | ^(TYPE 'long')  { $v = ir_pass1_t_long_new(IR_PASS1_ANTLR3_USERP()); }
  | ^(TYPE 'ulong') { $v = ir_pass1_t_ulong_new(IR_PASS1_ANTLR3_USERP()); }
  | ^(TYPE 'char')  { $v = ir_pass1_t_char_new(IR_PASS1_ANTLR3_USERP()); }
  | ^(TYPE 'string'){ $v = ir_pass1_t_string_new(IR_PASS1_ANTLR3_USERP()); }

  | ^(TYPE identifier) {
    $v = ir_pass1_t_custom_new(IR_PASS1_ANTLR3_USERP(), $identifier.v);
  }

  | ^(TYPE ^('array' tr=type_ref ^(ELEMS  ','*))) {
    size_t dimension = IR_ANTLR3_SIZE($ELEMS) + 1;
    $v = ir_pass1_t_array_new(IR_PASS1_ANTLR3_USERP(), dimension, $tr.v);
  }
  ;


// FUNCTIONS
func_def returns [ir_subroutine *v]
  : ^(FUNC func_signature (^(BODY func_body))? ) {
      $v = ir_pass1_subroutine_new(IR_PASS1_ANTLR3_USERP(), $func_signature.v);
    }
  ;

func_signature returns [ir_signature *v]
  @init {
    void *ret_v = NULL;
  }
  : id=identifier al=arg_def_list ^(RETURNS (r=type_ref { ret_v = $r.v; })?) {
      $v = ir_pass1_signature_new(IR_PASS1_ANTLR3_USERP(), ir_term_id_new($id.loc, $id.v), $al.v, ret_v);
    }
  ;

arg_def_list returns [p_list v]
  @init {
    p_list params = ir_pass1_params_new(IR_PASS1_ANTLR3_USERP());
  }
  : ^(PARAMS (arg_def {
      ir_pass1_param_add(IR_PASS1_ANTLR3_USERP(), params, $arg_def.v);
    })*) {
    $v = params;
  }
  ;

arg_def returns [ir_var *v]
  @init {
    void *type_ref_v = NULL;
  }
  : ^(PARAM id=identifier (type_ref { type_ref_v = $type_ref.v; })?) {
      $v = ir_pass1_param_new(IR_PASS1_ANTLR3_USERP(), ir_term_id_new($id.loc, $id.v), type_ref_v);
    }
  ;

// TODO: skip reading of whole BODY subtree
func_body
  : ^(VARS func_body_var*) statement_block
  ;

// free because not used
func_body_var
  : ^(VAR (type_ref { ir_t_free($type_ref.v); })? identifier*)
  ;


//STATEMENTS
statement
  : statement_if
  | statement_block
  | statement_while
  | statement_do
  | statement_break
  | statement_expression
  ;

statement_if
  : ^('if' expr statement statement?)
  ;

statement_block
  : ^('begin' statement*)
  ;

statement_while
  : ^('while' expr statement)
  ;

statement_do
  : ^('repeat' statement_do_condition statement)
  ;

statement_do_condition
  : ^('while' expr)
  | ^('until' expr)
  ;

statement_break
  : 'break'
  ;

statement_expression
  : expr
  ;


// EXPRESSIONS
expr
  : expr_14
  | expr_12
  | expr_11
  | expr_10
  | expr_9
  | expr_8
  | expr_7
  | expr_6
  | expr_5
  | expr_4
  | expr_3
  | expr_2
  | expr_caller
  | expr_indexer
  | expr_literal
  | expr_identifier
  ;


// OPERATORS
expr_15
  : expr*
  ;

expr_14
  : ^('=' expr expr)
  ;

expr_12
  : ^('||' expr expr)
  ;

expr_11
  : ^('&&' expr expr)
  ;

expr_10
  : ^('|' expr expr)
  ;

expr_9
  : ^('^' expr expr)
  ;

expr_8
  : ^('&' expr expr)
  ;

expr_7
  : ^('==' expr expr)
  | ^('!=' expr expr)
  ;

expr_6
  : ^('<' expr expr)
  | ^('<=' expr expr)
  | ^('>' expr expr)
  | ^('>=' expr expr)
  ;

expr_5
  : ^('<<' expr expr)
  | ^('>>' expr expr)
  ;

expr_4
  : ^('+' expr expr?)
  | ^('-' expr expr?)
  ;

expr_3
  : ^('*' expr expr)
  | ^('/' expr expr)
  | ^('%' expr expr)
  ;

// NOTE: excluding unary +/-
expr_2
  : ^('--' expr)
  | ^('++' expr)
  | ^('!' expr)
  | ^('~' expr)
  ;

expr_caller
  : ^(CALLER ^(ARGS expr_15) expr)
  ;

expr_indexer
  : ^(INDEXER ^(ARGS expr_15) expr)
  ;

expr_literal
  : bool | str | rune | hex | bits | dec
  ;

expr_identifier
  : identifier
  ;


// TERMINALS
identifier returns [const char *v, ir_loc loc]
  : id=IDENTIFIER {
      $v = IR_ANTLR3_CHARS($id);
      $loc = ir_loc_antlr3($id);
    };

str: ^(CONST_STR STR);
rune: ^(CONST_CHAR CHAR);
hex: ^(CONST_HEX HEX);
bits: ^(CONST_BITS BITS);
dec: ^(CONST_DEC DEC);
bool: ^(CONST_BOOL BOOL);
