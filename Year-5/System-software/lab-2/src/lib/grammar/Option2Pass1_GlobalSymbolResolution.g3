tree grammar Option2Pass1_GlobalSymbolResolution;

options {
  language = C;
  tokenVocab = Option2;
  ASTLabelType = pANTLR3_BASE_TREE;
}


@header {
#include "util/log.h"
#include "ir/expression.h"
#include "ir/function.h"
#include "ir/statement.h"
#include "ir/terminal.h"
#include "ir/type.h"
#include "ir/pass1.h"
}

@members {
}


// SOURCES
source
  : ^(ROOT source_item*)
  ;

source_item
  : func_def {
      ir_pass1_subroutine_add(IR_PASS1_ANTLR3_USERP(), $func_def.v);
    }
  ;


// TYPES
type_ref returns [ir_t_base *v]
  : 'bool'  { $v = ir_t_base_new(IR_T_BOOL); }
  | 'byte'  { $v = ir_t_base_new(IR_T_BYTE); }
  | 'int'   { $v = ir_t_base_new(IR_T_INT); }
  | 'uint'  { $v = ir_t_base_new(IR_T_UINT); }
  | 'long'  { $v = ir_t_base_new(IR_T_LONG); }
  | 'ulong' { $v = ir_t_base_new(IR_T_ULONG); }
  | 'char'  { $v = ir_t_base_new(IR_T_CHAR); }
  | 'string'{ $v = ir_t_base_new(IR_T_STRING); }

  | identifier {
      $v = (ir_t_base *) ir_t_custom_new($identifier.v);
    }

  | ^('array' tr=type_ref ^(ELEMS  ','*)) {
      size_t dimension = $ELEMS->children->size($ELEMS->children) + 1;
      $v = (ir_t_base *) ir_t_array_new(dimension, $tr.v);
    }
  ;


// FUNCTIONS
func_def returns [ir_subroutine *v]
  : ^(FUNC func_signature (^(BODY func_body))? ) {
      $v = ir_pass1_subroutine_new(IR_PASS1_ANTLR3_USERP(), $func_signature.v);
    }
  ;

func_signature returns [ir_signature *v]
  @init {
    void *ret_v = NULL;
  }
  : id=identifier al=arg_def_list ^(RETURNS (r=type_ref { ret_v = $r.v; })?) {
      $v = ir_signature_new(ir_term_id_new($id.v), $al.v, ret_v);
    }
  ;

arg_def_list returns [p_list v]
  @init {
    p_list params = ir_param_list_new();
  }
  @after {
    $v = params;
  }
  : ^(PARAMS (arg_def {
      ir_pass1_param_add(IR_PASS1_ANTLR3_USERP(), params, $arg_def.v);
    })*)
  ;

arg_def returns [ir_param *v]
  @init {
    void *type_ref_v = NULL;
  }
  : ^(PARAM id=identifier (type_ref { type_ref_v = $type_ref.v; })?) {
      $v = ir_param_new(ir_term_id_new($id.v), type_ref_v);
    }
  ;

// TODO: skip reading of whole BODY subtree
func_body
  : ^(VARS func_body_var*) statement_block
  ;

func_body_var
  : ^(VAR identifier type_ref?)
  ;


//STATEMENTS
statement
  : statement_if
  | statement_block
  | statement_while
  | statement_do
  | statement_break
  | statement_expression
  ;

statement_if
  : ^('if' expr statement statement?)
  ;

statement_block
  : ^('begin' statement*)
  ;

statement_while
  : ^('while' expr statement)
  ;

statement_do
  : ^('repeat' statement_do_condition statement)
  ;

statement_do_condition
  : ^('while' expr)
  | ^('until' expr)
  ;

statement_break
  : 'break'
  ;

statement_expression
  : expr
  ;


// EXPRESSIONS
expr
  : expr_14
  | expr_12
  | expr_11
  | expr_10
  | expr_9
  | expr_8
  | expr_7
  | expr_6
  | expr_5
  | expr_4
  | expr_3
  | expr_2
  | expr_caller
  | expr_indexer
  | expr_literal
  | expr_identifier
  ;


// OPERATORS
expr_15
  : expr*
  ;

expr_14
  : ^('=' expr expr)
  ;

expr_12
  : ^('||' expr expr)
  ;

expr_11
  : ^('&&' expr expr)
  ;

expr_10
  : ^('|' expr expr)
  ;

expr_9
  : ^('^' expr expr)
  ;

expr_8
  : ^('&' expr expr)
  ;

expr_7
  : ^('==' expr expr)
  | ^('!=' expr expr)
  ;

expr_6
  : ^('<' expr expr)
  | ^('<=' expr expr)
  | ^('>' expr expr)
  | ^('>=' expr expr)
  ;

expr_5
  : ^('<<' expr expr)
  | ^('>>' expr expr)
  ;

expr_4
  : ^('+' expr expr?)
  | ^('-' expr expr?)
  ;

expr_3
  : ^('*' expr expr)
  | ^('/' expr expr)
  | ^('%' expr expr)
  ;

// NOTE: excluding unary +/-
expr_2
  : ^('--' expr)
  | ^('++' expr)
  | ^('!' expr)
  | ^('~' expr)
  ;

expr_caller
  : ^(CALLER ^(ARGS expr_15) expr)
  ;

expr_indexer
  : ^(INDEXER ^(ARGS expr_15) expr)
  ;

expr_literal
  : bool | str | rune | hex | bits | dec
  ;

expr_identifier
  : identifier
  ;


// TERMINALS
identifier returns [const char *v]
  : id=IDENTIFIER {
      $v = (const char *) $id->getText($id)->to8($id->getText($id))->chars;
    };

str: ^(CONST_STR STR);
rune: ^(CONST_CHAR CHAR);
hex: ^(CONST_HEX HEX);
bits: ^(CONST_BITS BITS);
dec: ^(CONST_DEC DEC);
bool: ^(CONST_BOOL BOOL);
