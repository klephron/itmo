def getRepoURL() {
  return readFile("jenkins_repository-url").trim()
}

def getCommitSha() {
  return readFile("jenkins_commit-sha").trim()
}

def setPipelineStatus(String message, String state) {
  def repoUrl = getRepoURL()
  def commitSha = getCommitSha()
  step([
    $class: 'GitHubCommitStatusSetter',
    reposSource: [$class: "ManuallyEnteredRepositorySource", url: repoUrl],
    commitShaSource: [$class: "ManuallyEnteredShaSource", sha: commitSha],
    errorHandlers: [[$class: "ChangingBuildStatusErrorHandler", result: "UNSTABLE"]],
    statusResultSource: [$class: "ConditionalStatusResultSource", results: [[$class: "AnyBuildResult", message: message, state: state]]]
  ])
}

pipeline {
  options {
    skipDefaultCheckout(true)
    // disableConcurrentBuilds()
  }

  agent none

  environment {
    REGISTRY_URL = 'https://index.docker.io/v1/'
    REGISTRY_CRED_ID = 'dockerhub-zubrailx-password'
  }

  stages {
    stage('Preparation') {
      agent { label 'jenkins-agent-1' }
      steps {
        script {
          checkout scm

          sh '''#!/bin/bash
              git config --get remote.origin.url > jenkins_repository-url
              git rev-parse HEAD > jenkins_commit-sha
          '''

          setPipelineStatus('Pipeline started', 'PENDING');

          stash name: 'workspace', includes: '**'
        }
      }
    }

    stage('Services') {
      parallel {
        stage('Account Service') {
          agent { label 'jenkins-agent-1' }
          environment {
            SERVICE_DIR = "account-service"
            SERVICE_PATH = "${WORKSPACE}/${SERVICE_DIR}"
            SERVICE_IMAGE = "zubrailx/ahla-account-service"
            SERVICE_TEST_IMAGE = "zubrailx/ahla-account-service-test"
          }
          stages {
            stage('Build Test Image') {
              steps {
                unstash 'workspace'
                script {
                  sh 'ls -la .git/'
                  docker.build("${SERVICE_TEST_IMAGE}", "${SERVICE_PATH} -f ${SERVICE_PATH}/test.Dockerfile")
                }
              }
            }
            stage('Test Unit') {
              steps {
                script {
                  docker.image("${SERVICE_TEST_IMAGE}").inside("--user root") {
                    sh """
                      cd /app
                      mvn test -Dgroups=unit
                      cp -r /app/target ${SERVICE_PATH}/target
                      chown 1000:1000 -R ${SERVICE_PATH}/target
                    """
                  }
                }

                archiveArtifacts(artifacts: "${SERVICE_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${SERVICE_DIR}/target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${SERVICE_DIR}/target/surefire-reports/*.xml", )
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${SERVICE_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'account-service-jacoco-unit',
                  name: 'Account Service JaCoCo Unit Coverage',
                  sourceDirectories: [[path: "${SERVICE_DIR}/src/main/java"]])
              }
            }
            stage('Test Integration') {
              steps {
                script {
                  docker.image("${SERVICE_TEST_IMAGE}").inside("--user root -v /var/run/docker.sock:/var/run/docker.sock") {
                    sh """
                      cd /app
                      mvn test -Dgroups=integration
                      cp -r /app/target ${SERVICE_PATH}/target
                      chown 1000:1000 -R ${SERVICE_PATH}/target
                    """
                  }
                }

                archiveArtifacts(artifacts: "${SERVICE_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${SERVICE_DIR}/target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${SERVICE_DIR}/target/surefire-reports/*.xml")
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${SERVICE_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'account-service-jacoco-integration',
                  name: 'Account Service JaCoCo Integration Coverage',
                  sourceDirectories: [[path: "${SERVICE_DIR}/src/main/java"]])
              }
            }
            stage('Build') {
              steps {
                script {
                  docker.build("${SERVICE_IMAGE}:" + getCommitSha(), "${SERVICE_PATH}")
                }
              }
            }
            stage('Push') {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${SERVICE_IMAGE}:" + getCommitSha()).push()
                    docker.image("${SERVICE_IMAGE}:" + getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
        stage('Consul') {
          agent { label 'jenkins-agent-1' }
          environment {
            SERVICE_PATH = "${WORKSPACE}/consul"
            SERVICE_IMAGE = "zubrailx/ahla-consul"
          }
