                  docker.image("${SERVICE_TEST_IMAGE}").inside("--user root -v /var/run/docker.sock:/var/run/docker.sock") {
                    sh """
                      cd /app
                      mvn test -Dgroups=integration
                      cp -r /app/target ${SERVICE_PATH}/target
                      chown 1000:1000 -R ${SERVICE_PATH}/target
                    """
