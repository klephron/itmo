              steps {
                script {
                  docker.build("${SERVICE_IMAGE}:" + getCommitSha(), "${SERVICE_PATH}")
                }
              }
            }
            stage('Push') {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${SERVICE_IMAGE}:" + getCommitSha()).push()
                    docker.image("${SERVICE_IMAGE}:" + getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
        stage('Logstash') {
          agent { label 'jenkins-agent-1' }
          environment {
            SERVICE_PATH = "${WORKSPACE}/logstash"
            SERVICE_IMAGE = "zubrailx/ahla-logstash"
          }
          stages {
            stage("Build") {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${SERVICE_IMAGE}:" + getCommitSha(), "${SERVICE_PATH}")
                }
              }
            }
            stage("Push") {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${SERVICE_IMAGE}:" + getCommitSha()).push()
                    docker.image("${SERVICE_IMAGE}:" + getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
        stage('Rule Engine') {
          agent { label 'jenkins-agent-1' }
          environment {
            SERVICE_DIR = "rule-engine"
            SERVICE_PATH = "${WORKSPACE}/${SERVICE_DIR}"
            SERVICE_IMAGE = "zubrailx/ahla-rule-engine"
            SERVICE_TEST_IMAGE = "zubrailx/ahla-rule-engine-test"
          }
          stages {
            stage('Build Test Image') {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${SERVICE_TEST_IMAGE}", "${SERVICE_PATH} -f ${SERVICE_PATH}/test.Dockerfile")
                }
              }
            }
            stage('Test Unit') {
              steps {
                script {
                  docker.image("${SERVICE_TEST_IMAGE}").inside("--user root") {
                    sh """
                      cd /app
                      mvn test -Dgroups=unit
                      cp -r /app/target ${SERVICE_PATH}/target
                      chown 1000:1000 -R ${SERVICE_PATH}/target
                    """
                  }
                }

                archiveArtifacts(artifacts: "${SERVICE_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${SERVICE_DIR}/target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${SERVICE_DIR}/target/surefire-reports/*.xml")
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${SERVICE_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'rule-engine-jacoco-unit',
                  name: 'Rule Engine JaCoCo Unit Coverage',
                  sourceDirectories: [[path: "${SERVICE_DIR}/src/main/java"]])
              }
            }
            stage('Test Integration') {
              steps {
                script {
                  docker.image("${SERVICE_TEST_IMAGE}").inside("--user root -v /var/run/docker.sock:/var/run/docker.sock") {
                    sh """
                      cd /app
                      mvn test -Dgroups=integration
                      cp -r /app/target ${SERVICE_PATH}/target
                      chown 1000:1000 -R ${SERVICE_PATH}/target
                    """
                  }
                }

                archiveArtifacts(artifacts: "${SERVICE_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${SERVICE_DIR}/target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${SERVICE_DIR}/target/surefire-reports/*.xml")
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${SERVICE_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'rule-engine-jacoco-integration',
                  name: 'Rule Engine JaCoCo Integration Coverage',
                  sourceDirectories: [[path: "${SERVICE_DIR}/src/main/java"]])
              }
            }
            stage('Build') {
              steps {
                script {
                  docker.build("${SERVICE_IMAGE}:" + getCommitSha(), "${SERVICE_PATH}")
                }
              }
            }
            stage('Push') {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${SERVICE_IMAGE}:" + getCommitSha()).push()
                    docker.image("${SERVICE_IMAGE}:" + getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  post {
    always {
      script {
        node('jenkins-agent-1') {
          unstash 'workspace'
          try {
            if (currentBuild.currentResult == 'SUCCESS') {
                setPipelineStatus("Pipeline succeeded", "SUCCESS")
            } else if (currentBuild.currentResult == 'FAILURE') {
                setPipelineStatus("Pipeline failed", "FAILURE")
            }
          } finally {
            cleanWs()
          }
        }
      }
    }
  }
}
