FROM ubuntu:24.04

ENV ANSIBLE_VERSION=2.18.5
ENV PATH="/root/.local/bin:$PATH"

RUN apt update && \
  apt install -y python3 python3-pip python3-venv pipx && \
  apt clean && \
  rm -rf /var/lib/apt/lists/*

RUN pipx install ansible-core==${ANSIBLE_VERSION}

RUN apt update && \
  apt install -y ssh iputils-ping iproute2 rsync && \
  apt clean && \
  rm -rf /var/lib/apt/lists/*

RUN ansible-galaxy collection install ansible.posix community.docker

WORKDIR /ansible

CMD ["/bin/bash"]
