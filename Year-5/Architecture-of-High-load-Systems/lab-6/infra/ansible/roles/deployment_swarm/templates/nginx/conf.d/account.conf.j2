upstream account {
  {% if account_balancer == 'least_conn' %}
  least_conn;
  {% elif account_balancer == 'random' %}
  random;
  {% endif %}

  {% for service in consul_account_services %}
  server {{ service.Service.Address }}:{{ service.Service.Port }};
  {% endfor %}
}

server {
  listen 80;
  location / {
    proxy_pass http://account;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}