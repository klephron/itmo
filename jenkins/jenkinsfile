def getRepoURL() {
  sh "git config --get remote.origin.url > .git/remote-url"

  return readFile(".git/remote-url").trim()
}

def getCommitSha() {
  sh "git rev-parse HEAD > .git/current-commit"
  return readFile(".git/current-commit").trim()
}

def setPipelineStatus(String message, String state) {
  def repoUrl = getRepoURL()
  def commitSha = getCommitSha()

  echo "Repo URL: ${repoUrl}"
  echo "Commit SHA: ${commitSha}"

  step([
    $class: 'GitHubCommitStatusSetter',
    reposSource: [$class: "ManuallyEnteredRepositorySource", url: repoUrl],
    commitShaSource: [$class: "ManuallyEnteredShaSource", sha: commitSha],
    errorHandlers: [[$class: "ChangingBuildStatusErrorHandler", result: "UNSTABLE"]],
    statusResultSource: [$class: "ConditionalStatusResultSource", results: [[$class: "AnyBuildResult", message: message, state: state]]]
  ])
}

pipeline {
  options {
    skipDefaultCheckout(true)
    // disableConcurrentBuilds()
  }

  agent {
    label 'jenkins-agent-1'
  }

  environment {
    REGISTRY_URL = 'https://index.docker.io/v1/'
    REGISTRY_CRED_ID = 'dockerhub-zubrailx-password'
  }

  stages {
    stage('Preparation') {
      steps {
        script {
          checkout scm
          setPipelineStatus('Pipeline started', 'PENDING');
          env.COMMIT_SHA = getCommitSha()
          stash name: 'workspace', includes: '**'
        }
      }
    }

    stage('Services') {
      parallel {
        stage('Account Service') {
          environment {
            SERVICE_PATH = "${WORKSPACE}/account-service"
          }
          stages {
            stage('Build Test Image') {
              steps {
                echo "Account Service Build Test Image"
              }
            }
            stage('Test Unit') {
              steps {
                echo "Account Service Test Unit"
              }
            }
            stage('Test Integration') {
              steps {
                echo "Account Service Test Integration"
              }
            }
            stage('Build') {
              steps {
                echo "Account Service Build"
              }
            }
            stage('Push') {
              steps {
                echo "Account Service Push"
              }
            }
          }
        }
        stage('Consul') {
          environment {
            SERVICE_PATH = "${WORKSPACE}/consul"
            SERVICE_IMAGE = "zubrailx/ahla-consul"
            SERVICE_IMAGE_TAG = getCommitSha()
          }
          stages {
            stage("Build") {
              steps {
                script {
                  docker.build("${SERVICE_IMAGE}:${SERVICE_IMAGE_TAG}", "${SERVICE_PATH}")
                }
              }
            }
            stage("Push") {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${SERVICE_IMAGE}:${SERVICE_IMAGE_TAG}").push()
                    docker.image("${SERVICE_IMAGE}:${SERVICE_IMAGE_TAG}").push("latest")
                  }
                }
              }
            }
          }
        }
        stage('Data Simulator') {
          steps {
            echo "Data Simulator"
          }
        }
        stage('IoT Controller') {
          steps {
            echo "IoT Controller"
          }
        }
        stage('Logstash') {
          steps {
            echo "Logstash"
          }
        }
        stage('Rule Engine') {
          steps {
            echo "Rule Engine"
          }
        }
      }
    }
  }
  post {
    success {
      setPipelineStatus("Pipeline succeeded", "SUCCESS");
    }
    failure {
      setPipelineStatus("Pipeline failed", "FAILURE");
    }
    cleanup {
      cleanWs()
    }
  }
}
