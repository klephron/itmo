def util;

pipeline {
  options {
    skipDefaultCheckout(false)
  }

  agent none

  environment {
    REGISTRY_URL = 'https://index.docker.io/v1/'
    REGISTRY_CRED_ID = 'dockerhub-zubrailx-password'

    ACCOUNT_DIR = "account"
    ACCOUNT_IMAGE = "zubrailx/ahla-account"
    ACCOUNT_TEST_IMAGE = "zubrailx/ahla-account-test"

    CONSUL_DIR = "consul"
    CONSUL_IMAGE = "zubrailx/ahla-consul"

    DATA_SIMULATOR_DIR = "data-simulator"
    DATA_SIMULATOR_IMAGE = "zubrailx/ahla-data-simulator"
    DATA_SIMULATOR_TEST_IMAGE = "zubrailx/ahla-data-simulator-test"

    IOT_CONTROLLER_DIR = "iot-controller"
    IOT_CONTROLLER_IMAGE = "zubrailx/ahla-iot-controller"
    IOT_CONTROLLER_TEST_IMAGE = "zubrailx/ahla-iot-controller-test"

    LOGSTASH_DIR = "logstash"
    LOGSTASH_IMAGE = "zubrailx/ahla-logstash"

    RULE_ENGINE_DIR = "rule-engine"
    RULE_ENGINE_IMAGE = "zubrailx/ahla-rule-engine"
    RULE_ENGINE_TEST_IMAGE = "zubrailx/ahla-rule-engine-test"
  }

  stages {
    stage('Preparation') {
    agent { label 'jenkins-agent-1' }
      steps {
        checkout scm

        script {
          util = load('util.groovy')

          def branchName = util.gitBranchName()
          def commitSha = util.gitCommitSha()
          def repoURL = util.gitRepoURL()
          def tagName = util.gitTagName()

          if (branchName) {
            sh "echo ${branchName} > jenkins-branch-name"
          }
          if (commitSha) {
            sh "echo ${commitSha} > jenkins-commit-sha"
          }
          if (repoURL) {
            sh "echo ${repoURL} > jenkins-repository-url"
          }
          if (tagName) {
            sh "echo ${tagName} > jenkins-tag-name"
          }

          util.setPipelineStatus('Pipeline started', 'PENDING')
        }

        stash name: 'workspace', includes: '**'
      }
    }

    stage('Integration and Delivery') {
      parallel {
        stage('Account') {
          agent { label 'jenkins-agent-1' }
          stages {
            stage('Build Test Image') {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${ACCOUNT_TEST_IMAGE}",
                    "${WORKSPACE}/${ACCOUNT_DIR} -f ${WORKSPACE}/${ACCOUNT_DIR}/test.dockerfile")
                }
              }
            }
            stage('Test Unit') {
              steps {
                script {
                  docker.image("${ACCOUNT_TEST_IMAGE}").inside("--user root") {
                    sh """
                      cd /app
                      mvn test -Dgroups=unit
                      cp -r /app/target ${WORKSPACE}/${ACCOUNT_DIR}/target
                      chown 1000:1000 -R ${WORKSPACE}/${ACCOUNT_DIR}/target
                    """
                  }
                }
                archiveArtifacts(artifacts: "${ACCOUNT_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${ACCOUNT_DIR}/target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${ACCOUNT_DIR}/target/surefire-reports/*.xml", )
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${ACCOUNT_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'account-jacoco-unit',
                  name: 'Account JaCoCo Unit Coverage',
                  sourceDirectories: [[path: "${ACCOUNT_DIR}/src/main/java"]])
              }
            }
            stage('Test Integration') {
              steps {
                script {
                  docker.image("${ACCOUNT_TEST_IMAGE}").inside("--user root -v /var/run/docker.sock:/var/run/docker.sock") {
                    sh """
                      cd /app
                      mvn test -Dgroups=integration
                      cp -r /app/target ${WORKSPACE}/${ACCOUNT_DIR}/target
                      chown 1000:1000 -R ${WORKSPACE}/${ACCOUNT_DIR}/target
                    """
                  }
                }

                archiveArtifacts(artifacts: "${ACCOUNT_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${ACCOUNT_DIR}/target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${ACCOUNT_DIR}/target/surefire-reports/*.xml")
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${ACCOUNT_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'account-jacoco-integration',
                  name: 'Account JaCoCo Integration Coverage',
                  sourceDirectories: [[path: "${ACCOUNT_DIR}/src/main/java"]])
              }
            }
            stage('Build') {
              steps {
                script {
                  docker.build("${ACCOUNT_IMAGE}:" + util.getCommitSha(), "${WORKSPACE}/${ACCOUNT_DIR}")
                }
              }
            }
            stage('Push') {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${ACCOUNT_IMAGE}:" + util.getCommitSha()).push()
                    docker.image("${ACCOUNT_IMAGE}:" + util.getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
        stage('Consul') {
          agent { label 'jenkins-agent-1' }
          stages {
            stage("Build") {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${CONSUL_IMAGE}:" + util.getCommitSha(), "${WORKSPACE}/${CONSUL_DIR}")
                }
              }
            }
            stage("Push") {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${CONSUL_IMAGE}:" + util.getCommitSha()).push()
                    docker.image("${CONSUL_IMAGE}:" + util.getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
        stage('Data Simulator') {
          agent { label 'jenkins-agent-1' }
          stages {
            stage('Build Test Image') {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${DATA_SIMULATOR_TEST_IMAGE}",
                    "${WORKSPACE}/${DATA_SIMULATOR_DIR} -f ${WORKSPACE}/${DATA_SIMULATOR_DIR}/test.dockerfile")
                }
              }
            }
            stage('Test Unit') {
              steps {
                script {
                  docker.image("${DATA_SIMULATOR_TEST_IMAGE}").inside("--user root") {
                    sh """
                      cd /app
                      mvn test -Dgroups=unit
                      cp -r /app/target ${WORKSPACE}/${DATA_SIMULATOR_DIR}/target
                      chown 1000:1000 -R ${WORKSPACE}/${DATA_SIMULATOR_DIR}/target
                    """
                  }
                }

                archiveArtifacts(artifacts: "${DATA_SIMULATOR_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${DATA_SIMULATOR_DIR}target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${DATA_SIMULATOR_DIR}/target/surefire-reports/*.xml")
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${DATA_SIMULATOR_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'data-simulator-jacoco-unit',
                  name: 'Data Simulator JaCoCo Unit Coverage',
                  sourceDirectories: [[path: "${DATA_SIMULATOR_DIR}/src/main/java"]])
              }
            }
            stage('Test Integration') {
              steps {
                script {
                  docker.image("${DATA_SIMULATOR_TEST_IMAGE}").inside("--user root -v /var/run/docker.sock:/var/run/docker.sock") {
                    sh """
                      cd /app
                      mvn test -Dgroups=integration
                      cp -r /app/target ${WORKSPACE}/${DATA_SIMULATOR_DIR}/target
                      chown 1000:1000 -R ${WORKSPACE}/${DATA_SIMULATOR_DIR}/target
                    """
                  }
                }

                archiveArtifacts(artifacts: "${DATA_SIMULATOR_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${DATA_SIMULATOR_DIR}/target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${DATA_SIMULATOR_DIR}/target/surefire-reports/*.xml")
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${DATA_SIMULATOR_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'data-simulator-jacoco-integration',
                  name: 'Data Simulator JaCoCo Integration Coverage',
                  sourceDirectories: [[path: "${DATA_SIMULATOR_DIR}/src/main/java"]])
              }
            }
            stage('Build') {
              steps {
                script {
                  docker.build("${DATA_SIMULATOR_IMAGE}:" + util.getCommitSha(), "${WORKSPACE}/${DATA_SIMULATOR_DIR}")
                }
              }
            }
            stage('Push') {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${DATA_SIMULATOR_IMAGE}:" + util.getCommitSha()).push()
                    docker.image("${DATA_SIMULATOR_IMAGE}:" + util.getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
        stage('IoT Controller') {
          agent { label 'jenkins-agent-1' }
          stages {
            stage('Build Test Image') {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${IOT_CONTROLLER_TEST_IMAGE}",
                    "${WORKSPACE}/${IOT_CONTROLLER_DIR} -f ${WORKSPACE}/${IOT_CONTROLLER_DIR}/test.dockerfile")
                }
              }
            }
            stage('Test Unit') {
              steps {
                script {
                  docker.image("${IOT_CONTROLLER_TEST_IMAGE}").inside("--user root") {
                    sh """
                      cd /app
                      mvn test -Dgroups=unit
                      cp -r /app/target ${WORKSPACE}/${IOT_CONTROLLER_DIR}/target
                      chown 1000:1000 -R ${WORKSPACE}/${IOT_CONTROLLER_DIR}/target
                    """
                  }
                }

                archiveArtifacts(artifacts: "${IOT_CONTROLLER_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${IOT_CONTROLLER_DIR}/target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${IOT_CONTROLLER_DIR}/target/surefire-reports/*.xml")
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${IOT_CONTROLLER_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'iot-controller-jacoco-unit',
                  name: 'IoT Controller JaCoCo Unit Coverage',
                  sourceDirectories: [[path: "${IOT_CONTROLLER_DIR}/src/main/java"]])
              }
            }
            stage('Test Integration') {
              steps {
                script {
                  docker.image("${IOT_CONTROLLER_TEST_IMAGE}").inside("--user root -v /var/run/docker.sock:/var/run/docker.sock") {
                    sh """
                      cd /app
                      mvn test -Dgroups=integration
                      cp -r /app/target ${WORKSPACE}/${IOT_CONTROLLER_DIR}/target
                      chown 1000:1000 -R ${WORKSPACE}/${IOT_CONTROLLER_DIR}/target
                    """
                  }
                }

                archiveArtifacts(artifacts: "${IOT_CONTROLLER_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${IOT_CONTROLLER_DIR}/target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${IOT_CONTROLLER_DIR}/target/surefire-reports/*.xml")
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${IOT_CONTROLLER_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'iot-controller-jacoco-integration',
                  name: 'IoT Controller JaCoCo Integration Coverage',
                  sourceDirectories: [[path: "${IOT_CONTROLLER_DIR}/src/main/java"]])
              }
            }
            stage('Build') {
              steps {
                script {
                  docker.build("${IOT_CONTROLLER_IMAGE}:" + util.getCommitSha(), "${WORKSPACE}/${IOT_CONTROLLER_DIR}")
                }
              }
            }
            stage('Push') {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${IOT_CONTROLLER_IMAGE}:" + util.getCommitSha()).push()
                    docker.image("${IOT_CONTROLLER_IMAGE}:" + util.getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
        stage('Logstash') {
          agent { label 'jenkins-agent-1' }
          stages {
            stage("Build") {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${LOGSTASH_IMAGE}:" + util.getCommitSha(), "${WORKSPACE}/${LOGSTASH_DIR}")
                }
              }
            }
            stage("Push") {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${LOGSTASH_IMAGE}:" + util.getCommitSha()).push()
                    docker.image("${LOGSTASH_IMAGE}:" + util.getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
        stage('Rule Engine') {
          agent { label 'jenkins-agent-1' }
          stages {
            stage('Build Test Image') {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${RULE_ENGINE_TEST_IMAGE}",
                    "${WORKSPACE}/${RULE_ENGINE_DIR} -f ${WORKSPACE}/${RULE_ENGINE_DIR}/test.dockerfile")
                }
              }
            }
            stage('Test Unit') {
              steps {
                script {
                  docker.image("${RULE_ENGINE_TEST_IMAGE}").inside("--user root") {
                    sh """
                      cd /app
                      mvn test -Dgroups=unit
                      cp -r /app/target ${WORKSPACE}/${RULE_ENGINE_DIR}/target
                      chown 1000:1000 -R ${WORKSPACE}/${RULE_ENGINE_DIR}/target
                    """
                  }
                }

                archiveArtifacts(artifacts: "${RULE_ENGINE_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${RULE_ENGINE_DIR}/target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${RULE_ENGINE_DIR}/target/surefire-reports/*.xml")
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${RULE_ENGINE_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'rule-engine-jacoco-unit',
                  name: 'Rule Engine JaCoCo Unit Coverage',
                  sourceDirectories: [[path: "${RULE_ENGINE_DIR}/src/main/java"]])
              }
            }
            stage('Test Integration') {
              steps {
                script {
                  docker.image("${RULE_ENGINE_TEST_IMAGE}").inside("--user root -v /var/run/docker.sock:/var/run/docker.sock") {
                    sh """
                      cd /app
                      mvn test -Dgroups=integration
                      cp -r /app/target ${WORKSPACE}/${RULE_ENGINE_DIR}/target
                      chown 1000:1000 -R ${WORKSPACE}/${RULE_ENGINE_DIR}/target
                    """
                  }
                }

                archiveArtifacts(artifacts: "${RULE_ENGINE_DIR}/target/surefire-reports/*.xml", allowEmptyArchive: true)
                archiveArtifacts(artifacts: "${RULE_ENGINE_DIR}/target/site/jacoco/jacoco.xml", allowEmptyArchive: true)
                junit("${RULE_ENGINE_DIR}/target/surefire-reports/*.xml")
                recordCoverage(tools: [[parser: 'JACOCO', pattern: "${RULE_ENGINE_DIR}/target/site/jacoco/jacoco.xml"]],
                  id: 'rule-engine-jacoco-integration',
                  name: 'Rule Engine JaCoCo Integration Coverage',
                  sourceDirectories: [[path: "${RULE_ENGINE_DIR}/src/main/java"]])
              }
            }
            stage('Build') {
              steps {
                script {
                  docker.build("${RULE_ENGINE_IMAGE}:" + util.getCommitSha(), "${WORKSPACE}/${RULE_ENGINE_DIR}")
                }
              }
            }
            stage('Push') {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${RULE_ENGINE_IMAGE}:" + util.getCommitSha()).push()
                    docker.image("${RULE_ENGINE_IMAGE}:" + util.getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  post {
    always {
      script {
        node('jenkins-agent-1') {
          unstash 'workspace'
          try {
            if (currentBuild.currentResult == 'SUCCESS') {
                util.setPipelineStatus("Pipeline succeeded", "SUCCESS")
            } else if (currentBuild.currentResult == 'FAILURE') {
                util.setPipelineStatus("Pipeline failed", "FAILURE")
            }
          } finally {
            cleanWs()
          }
        }
      }
    }
  }
}
