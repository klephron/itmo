              steps {
                script {
                  docker.build("${IOT_CONTROLLER_IMAGE}:" + getCommitSha(), "${WORKSPACE}/${IOT_CONTROLLER_DIR}")
                }
              }
            }
            stage('Push') {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${IOT_CONTROLLER_IMAGE}:" + getCommitSha()).push()
                    docker.image("${IOT_CONTROLLER_IMAGE}:" + getCommitSha()).push("latest")
