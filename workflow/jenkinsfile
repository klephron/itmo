          }
        }
        stage('Logstash') {
          agent { label 'jenkins-agent-1' }
          stages {
            stage("Build") {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${LOGSTASH_IMAGE}:" + getCommitSha(), "${WORKSPACE}/${LOGSTASH_DIR}")
                }
              }
            }
            stage("Push") {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${LOGSTASH_IMAGE}:" + getCommitSha()).push()
                    docker.image("${LOGSTASH_IMAGE}:" + getCommitSha()).push("latest")
