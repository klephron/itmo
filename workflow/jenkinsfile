def gitBranchName() {
  def branch = sh(script: 'git symbolic-ref HEAD || git name-rev --name-only HEAD', returnStdout: true).trim()

  if (branch.contains('remotes/origin/')) {
    return branch.replaceAll('^remotes/origin/', '')
  } else if (branch.contains('refs/heads/')) {
    return branch.replaceAll('^refs/heads/', '')
  }
  return branch
}

def gitCommitSha() {
  return sh(script: 'git rev-parse HEAD', returnStdout: true)?.trim()
}

def gitRepoURL() {
  return sh(script: 'git config --get remote.origin.url', returnStdout: true)?.trim()
}

def isTag(String desc) {
    def match = desc =~ /.+-[0-9]+-g[0-9A-Fa-f]{6,}$/
    def result = !match
    match = null // prevent serialization
    return result
}

def gitTagName() {
  def commit = gitCommitSha()
  if (commit) {
      def desc = sh(script: "git describe --tags ${commit}", returnStdout: true)?.trim()
      if (isTag(desc)) {
          return desc
      }
  }
  return null
}

def getBranchName() {
  if (fileExists("jenkins_branch-name")) {
    return readFile("jenkins_branch-name").trim()
  }
  return null
}

def getCommitSha() {
  if (fileExists("jenkins_commit-sha")) {
    return readFile("jenkins_commit-sha").trim()
  }
  return null
}

def getRepoURL() {
  if (fileExists("jenkins_repository-url")) {
    return readFile("jenkins_repository-url").trim()
  }
  return null
}

def getTagName() {
  if (fileExists("jenkins_tag-name")) {
    return readFile("jenkins_tag-name").trim()
  }
  return null
}

def setPipelineStatus(String message, String state) {
  def repoURL = getRepoURL()
  def commitSha = getCommitSha()
  step([
    $class: 'GitHubCommitStatusSetter',
    reposSource: [$class: "ManuallyEnteredRepositorySource", url: repoURL],
    commitShaSource: [$class: "ManuallyEnteredShaSource", sha: commitSha],
    errorHandlers: [[$class: "ChangingBuildStatusErrorHandler", result: "UNSTABLE"]],
    statusResultSource: [$class: "ConditionalStatusResultSource", results: [[$class: "AnyBuildResult", message: message, state: state]]]
  ])
}

pipeline {
  agent none

  environment {
    REGISTRY_URL = 'https://index.docker.io/v1/'
    REGISTRY_CRED_ID = 'zubrailx-registry'

    FRONT_DIR = "front"
    FRONT_IMAGE = "zubrailx/devops-front"
    FRONT_TEST_IMAGE = "zubrailx/devops-front-test"
    FRONT_ENV_PATH_ID = 'devops_front_env_file'

    SERVER_DIR = "server"
    SERVER_IMAGE = "zubrailx/devops-server"
    SERVER_TEST_IMAGE = "zubrailx/devops-server-test"
  }

  stages {
    stage('Preparation') {
    agent { label 'jenkins-agent-1' }
      steps {
        script {
          def branchName = gitBranchName()
          def commitSha = gitCommitSha()
          def repoURL = gitRepoURL()
          def tagName = gitTagName()

          if (branchName) {
            sh "echo ${branchName} > jenkins_branch-name"
          }
          if (commitSha) {
            sh "echo ${commitSha} > jenkins_commit-sha"
          }
          if (repoURL) {
            sh "echo ${repoURL} > jenkins_repository-url"
          }
          if (tagName) {
            sh "echo ${tagName} > jenkins_tag-name"
          }
        }

        setPipelineStatus('Pipeline started', 'PENDING')

        stash name: 'workspace', includes: '**'
      }
    }

    stage('CI') {
      parallel {
        stage('Front') {
          agent { label 'jenkins-agent-1' }
          stages {
            stage('Test Build') {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${FRONT_TEST_IMAGE}", "${WORKSPACE}/${FRONT_DIR} -f ${WORKSPACE}/${FRONT_DIR}/test.dockerfile")
                }
              }
            }
            stage('Test Unit') {
              steps {
                script {
                  docker.image("${FRONT_TEST_IMAGE}").inside("--user root") {
                    sh '''
                      cd /app
                      yarn run test
                      yarn run coverage
                    '''
                  }
                }
              }
            }
          }
        }
        stage('Server') {
          agent { label 'jenkins-agent-1'}
          stages {
            stage('Test Build') {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${SERVER_TEST_IMAGE}", "${WORKSPACE}/${SERVER_DIR} -f ${WORKSPACE}/${SERVER_DIR}/test.dockerfile")
                }
              }
            }
            stage('Test Unit') {
              steps {
                script {
                  docker.image("${SERVER_TEST_IMAGE}").inside("--user root") {
                    sh '''
                      cd /app
                      ./mvnw test
                    '''
                  }
                }
              }
            }
          }
        }
      }
    }
    stage('CD') {
      parallel {
        stage('Front') {
          agent { label 'jenkins-agent-1'}
          stages {
            stage('Prepare') {
              steps {
                unstash 'workspace'
              }
            }
            stage('Build') {
              when {
                anyOf {
                  expression { return getBranchName() == "master" }
                  expression { return getTagName() }
                }
              }
              steps {
                script {
                  withCredentials([file(credentialsId: FRONT_ENV_PATH_ID, variable: 'FRONT_ENV_PATH')]) {
                      sh 'cp "$FRONT_ENV_PATH" "$WORKSPACE/$FRONT_DIR/.env.production"'
                  }
                  docker.build("${FRONT_IMAGE}:" + getCommitSha(), "${WORKSPACE}/${FRONT_DIR}")
                }
              }
            }
            stage('Push') {
              when {
                anyOf {
                  expression { return getBranchName() == "master" }
                  expression { return getTagName() }
                }
              }
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${FRONT_IMAGE}:" + getCommitSha()).push()
                    if (getTagName()) {
                      docker.image("${FRONT_IMAGE}:" + getCommitSha()).push(getTagName())
                    }
                    docker.image("${FRONT_IMAGE}:" + getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
        stage('Server') {
          agent { label 'jenkins-agent-1'}
          stages {
            stage('Prepare') {
              steps {
                unstash 'workspace'
              }
            }
            stage('Build') {
              when {
                anyOf {
                  expression { return getBranchName() == "master" }
                  expression { return getTagName() }
                }
              }
              steps {
                script {
                  docker.build("${SERVER_IMAGE}:" + getCommitSha(), "${WORKSPACE}/${SERVER_DIR}")
                }
              }
            }
            stage('Push') {
              when {
                anyOf {
                  expression { return getBranchName() == "master" }
                  expression { return getTagName() }
                }
              }
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    docker.image("${SERVER_IMAGE}:" + getCommitSha()).push()
                    if (getTagName()) {
                      docker.image("${SERVER_IMAGE}:" + getCommitSha()).push(getTagName())
                    }
                    docker.image("${SERVER_IMAGE}:" + getCommitSha()).push("latest")
                  }
                }
              }
            }
          }
        }
      }
    }
    stage('Deploy') {
      agent { label 'jenkins-agent-1' }
      stages {
        stage('Prepare') {
          steps {
            unstash 'workspace'
          }
        }
      }
    }
  }
  post {
    always {
      script {
        node('jenkins-agent-1') {
          unstash 'workspace'
          try {
            if (currentBuild.currentResult == 'SUCCESS') {
                setPipelineStatus("Pipeline succeeded", "SUCCESS")
            } else if (currentBuild.currentResult == 'FAILURE') {
                setPipelineStatus("Pipeline failed", "FAILURE")
            }
          } finally {
            cleanWs()
          }
        }
      }
    }
  }
}
