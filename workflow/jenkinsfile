def gitRepoURL() {
  return sh(script: 'git config --get remote.origin.url', returnStdout: true)?.trim()
}

def gitBranchName() {
  try {
    return "${BRANCH_NAME}"
  } catch (Exception e) {
    def branch = sh(script: 'git symbolic-ref --short HEAD || git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()

    if (branch.contains('remotes/origin/')) {
      return branch.replaceAll('^remotes/origin/', '')
    } else if (branch.contains('refs/heads/')) {
      return branch.replaceAll('^refs/heads/', '')
    }
    return branch
  }
}

def isTag(String desc) {
  def match = desc =~ /.+-[0-9]+-g[0-9A-Fa-f]{6,}$/
  def result = !match
  match = null // prevent serialization
  return result
}

def gitTagName() {
  try {
    return "${TAG_NAME}"
  } catch (Exception e) {
    def commit = gitCommitSha()
    if (commit) {
      try {
        def desc = sh(script: "git describe --tags ${commit}", returnStdout: true)?.trim()
        if (isTag(desc)) {
          return desc
        }
      } catch (Exception ee) {
        return null
      }
    }
    return null
  }
}

def gitCommitSha() {
  return sh(script: 'git rev-parse HEAD', returnStdout: true)?.trim()
}


def getRepoURL() {
  if (fileExists("jenkins-repository-url")) {
    return readFile("jenkins-repository-url").trim()
  }
  return null
}

def getBranchName() {
  if (fileExists("jenkins-branch-name")) {
    return readFile("jenkins-branch-name").trim()
  }
  return null
}

def getTagName() {
  if (fileExists("jenkins-tag-name")) {
    return readFile("jenkins-tag-name").trim()
  }
  return null
}

def getCommitSha() {
  if (fileExists("jenkins-commit-sha")) {
    return readFile("jenkins-commit-sha").trim()
  }
  return null
}


def setPipelineStatus(String message, String state) {
  def repoURL = getRepoURL()
  def commitSha = getCommitSha()
  step([
    $class: 'GitHubCommitStatusSetter',
    reposSource: [$class: "ManuallyEnteredRepositorySource", url: repoURL],
    commitShaSource: [$class: "ManuallyEnteredShaSource", sha: commitSha],
    errorHandlers: [[$class: "ChangingBuildStatusErrorHandler", result: "UNSTABLE"]],
    statusResultSource: [$class: "ConditionalStatusResultSource", results: [[$class: "AnyBuildResult", message: message, state: state]]]
  ])
}


def formatDockerTag(String branchName) {
  if (!branchName) {
    return null
  }
  def sanitized = branchName.replaceAll('/', '-').toLowerCase()
  sanitized = sanitized.replaceAll('[^a-z0-9._-]', '')
  return sanitized
}


pipeline {
  agent none

  environment {
    REGISTRY_URL = 'https://index.docker.io/v1/'
    REGISTRY_CRED_ID = 'zubrailx-registry'

    ANSIBLE_IMAGE = "zubrailx/devops-ansible:2.18.5"
    ANSIBLE_SSH_FILE_ID = "ssh_ansible_file"
    ANSIBLE_SSH_PUB_ID = "ssh_ansible_pub"

    FRONT_DIR = "front"
    FRONT_IMAGE = "zubrailx/devops-front"
    FRONT_TEST_IMAGE = "zubrailx/devops-front-test"
    FRONT_ENV_PATH_ID = 'devops_front_env_file'

    SERVER_DIR = "server"
    SERVER_IMAGE = "zubrailx/devops-server"
    SERVER_TEST_IMAGE = "zubrailx/devops-server-test"
  }

  stages {
    stage('Preparation') {
    agent { label 'jenkins-agent-1' }
      steps {
        script {
          def repoURL = gitRepoURL()
          def branchName = gitBranchName()
          def tagName = gitTagName()
          def commitSha = gitCommitSha()

          if (repoURL) {
            sh "echo ${repoURL} > jenkins-repository-url"
          }
          if (branchName) {
            sh "echo ${branchName} > jenkins-branch-name"
          }
          if (tagName) {
            sh "echo ${tagName} > jenkins-tag-name"
          }
          if (commitSha) {
            sh "echo ${commitSha} > jenkins-commit-sha"
          }
        }

        setPipelineStatus('Pipeline started', 'PENDING')

        stash name: 'workspace', includes: '**'
      }
    }

    stage('Integration') {
      parallel {
        stage('Front') {
          agent { label 'jenkins-agent-1' }
          stages {
            stage('Test Build') {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${FRONT_TEST_IMAGE}", "${WORKSPACE}/${FRONT_DIR} -f ${WORKSPACE}/${FRONT_DIR}/test.dockerfile")
                }
              }
            }
            stage('Test Unit') {
              steps {
                script {
                  docker.image("${FRONT_TEST_IMAGE}").inside("--user root") {
                    sh """
                      cd /app
                      yarn run test
                      yarn run coverage
                      cp -r /app/coverage ${WORKSPACE}/${FRONT_DIR}/.
                      chown 1000:1000 -R ${WORKSPACE}/${FRONT_DIR}/coverage
                    """
                  }
                }
              }
            }
            stage('SonarQube Analysis') {
              steps {
                script {
                  def scannerHome = tool('sonarqube_scanner')
                  dir("${WORKSPACE}/${FRONT_DIR}") {
                    withSonarQubeEnv("sonarqube_devops_server") {
                      sh """
                        ${scannerHome}/bin/sonar-scanner
                      """
                    }
                    try {
                      timeout(time: 2, unit: 'MINUTES') {
                        def qualityGate = waitForQualityGate()
                        if (qualityGate.status != 'OK') {
                          error "Pipeline aborted due to quality gate failure: ${qualityGate.status}"
                        }
                      }
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
                      unstable("Pipeline marked as unstable due to SonarQube QualityGate timeout")
                    }
                  }
                }
              }
            }
          }
        }
        stage('Server') {
          agent { label 'jenkins-agent-1'}
          stages {
            stage('Test Build') {
              steps {
                unstash 'workspace'
                script {
                  docker.build("${SERVER_TEST_IMAGE}", "${WORKSPACE}/${SERVER_DIR} -f ${WORKSPACE}/${SERVER_DIR}/test.dockerfile")
                }
              }
            }
            stage('Test Unit') {
              steps {
                script {
                  docker.image("${SERVER_TEST_IMAGE}").inside("--user root") {
                    sh """
                      cd /app
                      ./mvnw test
                      cp -r /app/target ${WORKSPACE}/${SERVER_DIR}/.
                      chown 1000:1000 -R ${WORKSPACE}/${SERVER_DIR}/target
                    """
                  }
                }
              }
            }
            stage('SonarQube Analysis') {
              steps {
                script {
                  def scannerHome = tool('sonarqube_scanner')
                  dir("${WORKSPACE}/${SERVER_DIR}") {
                    withSonarQubeEnv("sonarqube_devops_server") {
                      sh """
                        ${scannerHome}/bin/sonar-scanner
                      """
                    }
                    try {
                      timeout(time: 2, unit: 'MINUTES') {
                        def qualityGate = waitForQualityGate()
                        if (qualityGate.status != 'OK') {
                          error "Pipeline aborted due to quality gate failure: ${qualityGate.status}"
                        }
                      }
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
                      unstable("Pipeline marked as unstable due to SonarQube QualityGate timeout")
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    stage('Delivery') {
      parallel {
        stage('Front') {
          agent { label 'jenkins-agent-1'}
          stages {
            stage('Prepare') {
              steps {
                unstash 'workspace'
              }
            }
            stage('Build') {
              steps {
                script {
                  withCredentials([file(credentialsId: FRONT_ENV_PATH_ID, variable: 'FRONT_ENV_PATH')]) {
                      sh 'cp "$FRONT_ENV_PATH" "$WORKSPACE/$FRONT_DIR/.env.production"'
                  }
                  docker.build("${FRONT_IMAGE}:" + getCommitSha(), "${WORKSPACE}/${FRONT_DIR}")
                }
              }
            }
            stage('Push') {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    // docker.image("${FRONT_IMAGE}:" + getCommitSha()).push()
                    if (getTagName()) {
                      docker.image("${FRONT_IMAGE}:" + getCommitSha()).push(formatDockerTag(getTagName()))
                    }
                    if (getBranchName() == "master") {
                      docker.image("${FRONT_IMAGE}:" + getCommitSha()).push("latest")
                    } else {
                      docker.image("${FRONT_IMAGE}:" + getCommitSha()).push(formatDockerTag(getBranchName()))
                    }
                  }
                }
              }
            }
          }
        }
        stage('Server') {
          agent { label 'jenkins-agent-1'}
          stages {
            stage('Prepare') {
              steps {
                unstash 'workspace'
              }
            }
            stage('Build') {
              steps {
                script {
                  docker.build("${SERVER_IMAGE}:" + getCommitSha(), "${WORKSPACE}/${SERVER_DIR}")
                }
              }
            }
            stage('Push') {
              steps {
                script {
                  docker.withRegistry(REGISTRY_URL, REGISTRY_CRED_ID) {
                    // docker.image("${SERVER_IMAGE}:" + getCommitSha()).push()
                    if (getTagName()) {
                      docker.image("${SERVER_IMAGE}:" + getCommitSha()).push(formatDockerTag(getTagName()))
                    }
                    if (getBranchName() == "master") {
                      docker.image("${SERVER_IMAGE}:" + getCommitSha()).push("latest")
                    } else {
                      docker.image("${SERVER_IMAGE}:" + getCommitSha()).push(formatDockerTag(getBranchName()))
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    stage('Deployment') {
      agent { label 'jenkins-agent-1' }
      stages {
        stage('Prepare') {
          steps {
            unstash 'workspace'
          }
        }
        stage('Kubernetes') {
          when {
            expression { return getBranchName() == "master" }
            // expression { getTagName() }
          }
          steps {
            script {
              withCredentials([file(credentialsId: ANSIBLE_SSH_FILE_ID, variable: 'ANSIBLE_SSH_FILE_PATH')]) {
                  sh 'cp "$ANSIBLE_SSH_FILE_PATH" "$WORKSPACE/ansible-ssh-private-key"'
              }
              docker.image("${ANSIBLE_IMAGE}").inside("--user root --network host") {
                sh """
                  cd ${WORKSPACE}/infra/ansible
                  ansible-playbook --private-key=${WORKSPACE}/ansible-ssh-private-key \
                    kubernetes.yml -e infra_root=${WORKSPACE}/infra --tags=deploy
                """
              }
            }
          }
        }
      }
    }
  }
  post {
    always {
      script {
        node('jenkins-agent-1') {
          unstash 'workspace'
          try {
            if (currentBuild.currentResult == 'SUCCESS') {
                setPipelineStatus("Pipeline succeeded", "SUCCESS")
            } else if (currentBuild.currentResult == 'FAILURE') {
                setPipelineStatus("Pipeline failed", "FAILURE")
            }
          } finally {
            cleanWs()
          }
        }
      }
    }
  }
}
