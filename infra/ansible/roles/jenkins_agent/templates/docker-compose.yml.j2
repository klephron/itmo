services:
  jenkins-agent:
    image: {{ jenkins_agent_image }}
    environment:
      JENKINS_AGENT_SSH_PUBKEY: "{{ jenkins_agent_ssh_pubkey }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - jenkins-agent-docker:/var/lib/docker
    ports:
      - "{{ jenkins_agent_ssh_port }}:22"

volumes:
  jenkins-agent-docker:
