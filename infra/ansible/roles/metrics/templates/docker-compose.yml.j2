services:
  grafana:
    image: grafana/grafana:latest
    environment:
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_ADMIN_PASSWORD=admin
    volumes:
      - grafana-data:/var/lib/grafana
    ports:
      - "{{ grafana_port }}:3000"

  prometheus:
    image: prom/prometheus:latest
    volumes:
      - {{ project_prometheus_file }}:/etc/prometheus/prometheus.yml
      - {{ project_kubernetes_bearer_token_file }}:/etc/prometheus/bearer-token
      - prometheus-data:/prometheus
    ports:
      - "{{ prometheus_port }}:9090"

volumes:
  grafana-data:
  prometheus-data:
