---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: server
  namespace: {{ kubernetes_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: server
  template:
    metadata:
      labels:
        app: server
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "8080"
        prometheus.io/path: "/actuator/prometheus"
    spec:
      containers:
        - name: server
          image: {{ kubernetes_server_image }}
          ports:
            - containerPort: 8080
          env:
            - name: SPRING_DATASOURCE_URL
              value: "jdbc:postgresql://postgres:5432/me_db"
            - name: SPRING_DATASOURCE_USERNAME
              value: "me"
            - name: SPRING_DATASOURCE_PASSWORD
              value: "me"
            - name: SERVER_PORT
              value: "8080"
            - name: NOTIFY_SERVICE_ENDPOINT
              value: "{{ api_bot_endpoint }}"
          resources:
            requests:
              cpu: "200m"
              memory: "256Mi"
            limits:
              cpu: "400m"
              memory: "512Mi"
---
apiVersion: v1
kind: Service
metadata:
  name: server
  namespace: {{ kubernetes_namespace }}
spec:
  selector:
    app: server
  ports:
    - port: 8080
      targetPort: 8080
      nodePort: 30111
  type: NodePort
  sessionAffinity: None
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: server
  namespace: {{ kubernetes_namespace }}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: server
  minReplicas: 1
  maxReplicas: 10
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: AverageValue
          averageValue: 150m
  behavior:
    scaleDown:
      stabilizationWindowSeconds: 60
      policies:
        - type: Percent
          value: 100
          periodSeconds: 15
    scaleUp:
      stabilizationWindowSeconds: 0
      policies:
        - type: Percent
          value: 100 # of currently running replicas
          periodSeconds: 15
        - type: Pods
          value: 4
          periodSeconds: 15
      selectPolicy: Max
