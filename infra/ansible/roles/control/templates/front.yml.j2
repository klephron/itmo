---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: front
  namespace: {{ kubernetes_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: front
  template:
    metadata:
      labels:
        app: front
    spec:
      containers:
        - name: front
          image: {{ kubernetes_front_image }}
          ports:
            - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: front
  namespace: {{ kubernetes_namespace }}
spec:
  selector:
    app: front
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30110
  type: NodePort
  sessionAffinity: None
