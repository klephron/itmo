<?xml version="1.0"?>
<!DOCTYPE tsung SYSTEM "/usr/local/share/tsung/tsung-1.0.dtd">
<tsung loglevel="info">
<clients>
  <client host="localhost" use_controller_vm="true" maxusers="1000"/>
</clients>

  <servers>
    <server host="192.168.146.131" port="30111" type="tcp"/>
  </servers>

  <load>
    <!-- Фаза 1: много пользователей, низкая частота -->
    <arrivalphase phase="1" duration="2" unit="minute">
      <users interarrival="2" unit="second"/>
    </arrivalphase>

    <!-- Фаза 2: мало пользователей, высокая частота -->
    <arrivalphase phase="2" duration="2" unit="minute">
      <users arrivalrate="5" unit="second"/>
    </arrivalphase>

    <!-- Фаза 3: пиковая нагрузка -->
    <arrivalphase phase="3" duration="1" unit="minute">
      <users arrivalrate="20" unit="second"/>
    </arrivalphase>
  </load>


  <sessions>
    <session name="api_test" probability="100" type="ts_http">
      <!-- GET /networks -->
      <request>
        <http url="/networks" method="GET"/>
      </request>

      <!-- GET /patterns/1 -->
      <request>
        <http url="/patterns/1" method="GET"/>
      </request>

      <!-- POST /storageCells?driveId=1 -->
	<request>
	  <http url="/storageCells?driveId=1"
			method="POST" version="1.1"
			content_type="application/json"
			contents='{"capacity":100,"driveId":1}'/>
	</request>

      <!-- PUT /networks/1 -->
	<request>
	  <http url="/networks/1"
			method="PUT" version="1.1"
			content_type="application/json"
			contents='{"name":"Updated Network","channelCapacity":200,"usedChannels":50}'/>
	</request>

      <!-- DELETE /interfaces/1 -->
      <request>
        <http url="/interfaces/1" method="DELETE"/>
      </request>
    </session>
  </sessions>
</tsung>
